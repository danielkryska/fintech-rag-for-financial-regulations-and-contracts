        </mxCell>
        <mxCell id="orchestrator" value="&lt;b&gt;Indexing orchestrator&lt;/b&gt;&lt;br&gt;• consumes prepared documents from the ingestion slice&lt;br&gt;• routes documents to the chunking and embedding workers&lt;br&gt;• stores passages, keywords, and permission metadata&lt;br&gt;[orchestrator]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-backend">
          <mxGeometry x="600" y="20" width="440" height="180" as="geometry" />
        </mxCell>
        <mxCell id="chunking" value="&lt;b&gt;Chunking worker&lt;/b&gt;&lt;br&gt;• splits documents into searchable passages&lt;br&gt;• respects section hierarchy and context limits&lt;br&gt;[worker]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-backend">
