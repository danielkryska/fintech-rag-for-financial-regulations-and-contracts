<mxfile host="app.diagrams.net">
  <diagram id="lvl2-ingestion" name="L2 Document ingestion">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="2000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;C4 Level 2 - Document ingestion (v2, Draft)&lt;/b&gt;&lt;br&gt;Date: 2026-11-18&lt;br&gt;Requirements: FR-01, NFR-03&lt;br&gt;Flow: Web UI → API GW → BFF → pre-signed upload → raw store → event bus → metadata DB → transformation → workers → processed store → indexing&lt;br&gt;ADRs: none accepted yet" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1100" height="90" as="geometry" />
        </mxCell>

        <mxCell id="actor-records" value="&lt;span style=&quot;color:#ffffff;font-weight:bold&quot;&gt;Records administrator&lt;/span&gt;&lt;br&gt;[Person]&lt;br&gt;• uploads policy, contract, and regulatory documents" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#06315C;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="790" y="110" width="220" height="240" as="geometry" />
        </mxCell>

        <mxCell id="sys-container" value="&lt;b&gt;Enterprise RAG knowledge assistant&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;container=1;collapsible=0;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="390" width="1700" height="1300" as="geometry" />
        </mxCell>

        <!-- UI layer -->
        <mxCell id="grp-ui" value="&lt;b&gt;Web app UI&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;container=1;collapsible=0;fontSize=12;fontStyle=1;" vertex="1" parent="sys-container">
          <mxGeometry x="30" y="25" width="1640" height="190" as="geometry" />
        </mxCell>
        <mxCell id="web-ui" value="&lt;b&gt;Web Application&lt;/b&gt;&lt;br&gt;• uploads documents via pre-signed URLs to the raw store&lt;br&gt;• shows ingestion status and rejections&lt;br&gt;• lists / edits document records through the BFF&lt;br&gt;[web ui]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-ui">
          <mxGeometry x="600" y="30" width="460" height="120" as="geometry" />
        </mxCell>
        <mxCell id="api-gateway" value="&lt;b&gt;API gateway&lt;/b&gt;&lt;br&gt;• receives upload and CRUD requests&lt;br&gt;• validates the JWT with the IDP and propagates groups/roles&lt;br&gt;• routes authenticated requests to the BFF&lt;br&gt;[api gateway]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-ui">
          <mxGeometry x="1140" y="30" width="460" height="120" as="geometry" />
        </mxCell>

        <!-- Backend layer -->
        <mxCell id="grp-backend" value="&lt;b&gt;Backend&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;container=1;collapsible=0;fontSize=12;fontStyle=1;" vertex="1" parent="sys-container">
          <mxGeometry x="30" y="240" width="1640" height="740" as="geometry" />
        </mxCell>

        <mxCell id="bff" value="&lt;b&gt;BFF service&lt;/b&gt;&lt;br&gt;• generates pre-signed upload URLs for the raw store&lt;br&gt;• CRUD for document records (metadata + raw pointer)&lt;br&gt;• enforces RBAC using JWT group/role claims&lt;br&gt;[bff]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-backend">
          <mxGeometry x="40" y="30" width="260" height="170" as="geometry" />
        </mxCell>
        <mxCell id="event-bus" value="&lt;b&gt;Event bus&lt;/b&gt;&lt;br&gt;• transport for document.uploaded / document.processed&lt;br&gt;• decouples storage, metadata, and processing&lt;br&gt;[message broker]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-backend">
          <mxGeometry x="360" y="30" width="240" height="170" as="geometry" />
        </mxCell>
        <mxCell id="orchestrator" value="&lt;b&gt;Transformation orchestrator&lt;/b&gt;&lt;br&gt;• consumes processing triggers&lt;br&gt;• dispatches the right worker per file type&lt;br&gt;• validates documents and rejects malformed / poisoned input&lt;br&gt;• tracks status on metadata records&lt;br&gt;[orchestrator]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-backend">
          <mxGeometry x="940" y="30" width="360" height="200" as="geometry" />
        </mxCell>

        <mxCell id="pdf-worker" value="&lt;b&gt;PDF extractor worker&lt;/b&gt;&lt;br&gt;• extracts text from PDFs&lt;br&gt;• chunks text by hierarchy (chapters / sections)&lt;br&gt;• falls back to the OCR worker if text extraction fails&lt;br&gt;• writes chunks to temp storage&lt;br&gt;[worker]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-backend">
          <mxGeometry x="360" y="310" width="240" height="240" as="geometry" />
        </mxCell>
        <mxCell id="docx-worker" value="&lt;b&gt;DOCX extractor worker&lt;/b&gt;&lt;br&gt;• extracts text from DOCX documents&lt;br&gt;• chunks text by hierarchy&lt;br&gt;• writes chunks to temp storage&lt;br&gt;[worker]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-backend">
          <mxGeometry x="630" y="310" width="240" height="240" as="geometry" />
        </mxCell>
        <mxCell id="ocr-worker" value="&lt;b&gt;Image / OCR worker&lt;/b&gt;&lt;br&gt;• converts scanned pages and embedded PDF images to text&lt;br&gt;• chunks text by hierarchy&lt;br&gt;• also consumes image-processing events from the processed store&lt;br&gt;[worker]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-backend">
          <mxGeometry x="900" y="310" width="240" height="240" as="geometry" />
        </mxCell>
        <mxCell id="pii-worker" value="&lt;b&gt;PII redaction &amp; chunk writer&lt;/b&gt;&lt;br&gt;• detects and redacts personal data&lt;br&gt;• writes anonymized chunked JSON with placeholders such as &amp;lt;person 1&amp;gt; only&lt;br&gt;• writes the real-&amp;gt;placeholder mapping to the PII store&lt;br&gt;[worker]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-backend">
          <mxGeometry x="1170" y="310" width="240" height="240" as="geometry" />
        </mxCell>

        <!-- Repositories -->
        <mxCell id="grp-repos" value="&lt;b&gt;Repositories (DBs)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;container=1;collapsible=0;fontSize=12;fontStyle=1;" vertex="1" parent="sys-container">
          <mxGeometry x="30" y="1000" width="1640" height="270" as="geometry" />
        </mxCell>
        <mxCell id="raw-store" value="&lt;b&gt;Raw document store&lt;/b&gt;&lt;br&gt;• keeps original uploaded documents&lt;br&gt;• emits document.uploaded to the event bus&lt;br&gt;[object storage]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-repos">
          <mxGeometry x="24" y="25" width="280" height="215" as="geometry" />
        </mxCell>
        <mxCell id="meta-store" value="&lt;b&gt;Document metadata store&lt;/b&gt;&lt;br&gt;• document id, type, status, permissions&lt;br&gt;• receives file meta from the event consumer and triggers processing&lt;br&gt;[key-value store]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-repos">
          <mxGeometry x="352" y="25" width="280" height="215" as="geometry" />
        </mxCell>
        <mxCell id="temp-store" value="&lt;b&gt;Temp artifact storage&lt;/b&gt;&lt;br&gt;• keeps intermediate PDF, OCR, and DOCX chunk artifacts&lt;br&gt;[object storage]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-repos">
          <mxGeometry x="680" y="25" width="280" height="215" as="geometry" />
        </mxCell>
        <mxCell id="processed-store" value="&lt;b&gt;Processed document store&lt;/b&gt;&lt;br&gt;• keeps anonymized chunked JSON; only &amp;lt;person 1&amp;gt; style placeholders&lt;br&gt;• emits document.processed events to the indexing slice&lt;br&gt;• emits image-processing events for images embedded in PDFs&lt;br&gt;[object storage]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-repos">
          <mxGeometry x="1008" y="25" width="280" height="215" as="geometry" />
        </mxCell>
        <mxCell id="pii-store" value="&lt;b&gt;PII mapping store&lt;/b&gt;&lt;br&gt;• keeps real user personal data mapped to placeholders&lt;br&gt;• identity vault, access-restricted&lt;br&gt;[key-value store]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-repos">
          <mxGeometry x="1336" y="25" width="280" height="215" as="geometry" />
        </mxCell>

        <!-- External -->
        <mxCell id="slice-embed" value="&lt;b&gt;Embedding and indexing slice&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;consumes document.processed events" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="200" y="1740" width="420" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ext-idp" value="&lt;b&gt;Corporate identity provider&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;authenticates users, resolves groups and roles, embeds them in the JWT" style="shape=mxgraph.c4.external;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1150" y="1740" width="340" height="100" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend-1" value="&lt;b&gt;Legend&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;container=1;collapsible=0;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1900" width="900" height="60" as="geometry" />
        </mxCell>
        <mxCell id="legend-swatch-person" value="Person" style="shape=mxgraph.c4.person2;whiteSpace=wrap;fillColor=#1F4E79;strokeColor=#06315C;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="legend-1">
          <mxGeometry x="15" y="12" width="90" height="40" as="geometry" />
        </mxCell>
        <mxCell id="legend-swatch-system" value="Software system" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="legend-1">
          <mxGeometry x="115" y="12" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="legend-swatch-external" value="External system" style="shape=mxgraph.c4.external;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="legend-1">
          <mxGeometry x="245" y="12" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="legend-sync-src" style="rounded=0;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="legend-1">
          <mxGeometry x="395" y="25" width="30" height="12" as="geometry" />
        </mxCell>
        <mxCell id="legend-sync-tgt" style="rounded=0;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="legend-1">
          <mxGeometry x="475" y="25" width="30" height="12" as="geometry" />
        </mxCell>
        <mxCell id="legend-async-src" style="rounded=0;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="legend-1">
          <mxGeometry x="550" y="25" width="30" height="12" as="geometry" />
        </mxCell>
        <mxCell id="legend-async-tgt" style="rounded=0;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="legend-1">
          <mxGeometry x="630" y="25" width="30" height="12" as="geometry" />
        </mxCell>
        <mxCell id="legend-sync-text" value="sync" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="legend-1">
          <mxGeometry x="520" y="20" width="60" height="22" as="geometry" />
        </mxCell>
        <mxCell id="legend-async-text" value="async" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="legend-1">
          <mxGeometry x="675" y="20" width="60" height="22" as="geometry" />
        </mxCell>
        <mxCell id="legend-e-sync" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="legend-1" source="legend-sync-src" target="legend-sync-tgt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="legend-e-async" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;dashPattern=5 3;" edge="1" parent="legend-1" source="legend-async-src" target="legend-async-tgt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ EDGES ============ -->

        <!-- Person -> Web UI -->
        <mxCell id="e-upload" value="upload documents&#10;[http]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;align=left;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="actor-records" target="web-ui">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Web UI -> API Gateway -->
        <mxCell id="e-send" value="submit / CRUD&#10;[http]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;align=left;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="web-ui" target="api-gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- API Gateway -> IDP (routed outside the system on the right) -->
        <mxCell id="e-auth" value="validate token, fetch groups/roles&#10;[http]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;align=left;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="api-gateway" target="ext-idp">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1750" y="505" />
              <mxPoint x="1750" y="1700" />
              <mxPoint x="1320" y="1700" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- API Gateway -> BFF (routed through the gap between UI and backend) -->
        <mxCell id="e-route" value="route with JWT&#10;[http]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;align=left;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="api-gateway" target="bff">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1440" y="610" />
              <mxPoint x="240" y="610" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Web UI -> Raw store (upload via pre-signed URL, routed above/left outside groups) -->
        <mxCell id="e-web-upload" value="upload via pre-signed URL&#10;[https]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;align=left;exitX=0.83;exitY=0;entryX=0;entryY=0.63;" edge="1" parent="1" source="web-ui" target="raw-store">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1050" y="380" />
              <mxPoint x="55" y="380" />
              <mxPoint x="55" y="1550" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- BFF -> Raw store (generate pre-signed URL) -->
        <mxCell id="e-presign" value="generate pre-signed URL&#10;[api call]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;align=left;exitX=0.5;exitY=1;entryX=0.52;entryY=0;" edge="1" parent="1" source="bff" target="raw-store">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- BFF -> Metadata store (CRUD) -->
        <mxCell id="e-crud" value="CRUD document records&#10;[key-value read/write]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;align=left;exitX=1;exitY=0.5;entryX=0.28;entryY=0;" edge="1" parent="1" source="bff" target="meta-store">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="405" y="745" />
              <mxPoint x="405" y="1340" />
              <mxPoint x="500" y="1340" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Raw store -> Event bus -->
        <mxCell id="e-raw-event" value="document.uploaded&#10;[event]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;dashPattern=5 3;labelBackgroundColor=#ffffff;fontSize=11;align=left;exitX=0.74;exitY=0;entryX=0.21;entryY=1;" edge="1" parent="1" source="raw-store" target="event-bus">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="300" y="880" />
              <mxPoint x="480" y="880" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Event bus -> Metadata store (consumer persists meta) -->
        <mxCell id="e-event-meta" value="persist file meta&#10;[event]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;dashPattern=5 3;labelBackgroundColor=#ffffff;fontSize=11;align=left;exitX=0;exitY=0.5;entryX=0.46;entryY=0;" edge="1" parent="1" source="event-bus" target="meta-store">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="385" y="745" />
              <mxPoint x="385" y="1360" />
              <mxPoint x="550" y="1360" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Metadata store -> Orchestrator (trigger) -->
        <mxCell id="e-trigger" value="processing trigger&#10;[change event]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;dashPattern=5 3;labelBackgroundColor=#ffffff;fontSize=11;align=left;exitX=0.94;exitY=0;entryX=0.25;entryY=1;" edge="1" parent="1" source="meta-store" target="orchestrator">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="685" y="890" />
              <mxPoint x="1100" y="890" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Orchestrator -> workers -->
        <mxCell id="e-pdf" value="extract PDF&#10;[queue]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;dashPattern=5 3;labelBackgroundColor=#ffffff;fontSize=11;align=left;exitX=0.11;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="orchestrator" target="pdf-worker">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1050" y="900" />
              <mxPoint x="550" y="900" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-docx" value="extract DOCX&#10;[queue]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;dashPattern=5 3;labelBackgroundColor=#ffffff;fontSize=11;align=left;exitX=0.39;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="orchestrator" target="docx-worker">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1150" y="910" />
              <mxPoint x="820" y="910" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-ocr" value="run OCR&#10;[queue]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;dashPattern=5 3;labelBackgroundColor=#ffffff;fontSize=11;align=left;exitX=0.67;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="orchestrator" target="ocr-worker">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1250" y="920" />
              <mxPoint x="1090" y="920" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-pii" value="redact PII + write chunks&#10;[queue]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;dashPattern=5 3;labelBackgroundColor=#ffffff;fontSize=11;align=left;exitX=0.89;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="orchestrator" target="pii-worker">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1330" y="930" />
              <mxPoint x="1360" y="930" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- PDF fallback -> OCR -->
        <mxCell id="e-pdf-ocr" value="fallback to OCR&#10;[queue]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;dashPattern=5 3;labelBackgroundColor=#ffffff;fontSize=11;align=left;exitX=0.71;exitY=1;entryX=0.625;entryY=1;" edge="1" parent="1" source="pdf-worker" target="ocr-worker">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
