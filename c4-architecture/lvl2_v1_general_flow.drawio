<mxfile host="app.diagrams.net">
  <diagram id="lvl2-general-flow" name="L2 RAG pipeline flow">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;C4 Level 2 - General flow (v1, Confirmed)&lt;/b&gt;&lt;br&gt;Date: 2026-11-18&lt;br&gt;Requirements: FR-01 to FR-07, NFR-01 to NFR-08&lt;br&gt;ADRs: none accepted yet" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1100" height="70" as="geometry" />
        </mxCell>
        <mxCell id="actor-records" value="&lt;span style=&quot;color:#ffffff;font-weight:bold&quot;&gt;Records administrator&lt;/span&gt;&lt;br&gt;[Person]&lt;br&gt;• uploads documents" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#06315C;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="370" y="134" width="220" height="240" as="geometry" />
        </mxCell>
        <mxCell id="actor-employee" value="&lt;span style=&quot;color:#ffffff;font-weight:bold&quot;&gt;Employee&lt;/span&gt;&lt;br&gt;[Person]&lt;br&gt;• asks questions&lt;br&gt;• reads streamed answers" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#06315C;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="650" y="134" width="220" height="240" as="geometry" />
        </mxCell>
        <mxCell id="actor-compliance" value="&lt;span style=&quot;color:#ffffff;font-weight:bold&quot;&gt;Compliance officer&lt;/span&gt;&lt;br&gt;[Person]&lt;br&gt;• requests audit trails" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#06315C;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="930" y="134" width="220" height="240" as="geometry" />
        </mxCell>
        <mxCell id="actor-engineer" value="&lt;span style=&quot;color:#ffffff;font-weight:bold&quot;&gt;Engineer&lt;/span&gt;&lt;br&gt;[Person]&lt;br&gt;• defines policies&lt;br&gt;• reviews answers" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#06315C;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1210" y="134" width="220" height="240" as="geometry" />
        </mxCell>
        <mxCell id="sys-container" value="&lt;b&gt;Enterprise RAG knowledge assistant&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;container=1;collapsible=0;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="1720" height="760" as="geometry" />
        </mxCell>
        <mxCell id="grp-ui" value="&lt;b&gt;Web app UI&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;container=1;collapsible=0;fontSize=12;fontStyle=1;" vertex="1" parent="sys-container">
          <mxGeometry x="40" y="40" width="1600" height="130" as="geometry" />
        </mxCell>
        <mxCell id="grp-backend" value="&lt;b&gt;Backend&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;container=1;collapsible=0;fontSize=12;fontStyle=1;" vertex="1" parent="sys-container">
          <mxGeometry x="40" y="200" width="1600" height="330" as="geometry" />
        </mxCell>
        <mxCell id="grp-repos" value="&lt;b&gt;Repositories (DBs)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;container=1;collapsible=0;fontSize=12;fontStyle=1;" vertex="1" parent="sys-container">
          <mxGeometry x="40" y="560" width="1600" height="180" as="geometry" />
        </mxCell>
        <mxCell id="web-ui" value="&lt;b&gt;Web Application&lt;/b&gt;&lt;br&gt;• uploads documents through the browser&lt;br&gt;• asks questions and streams answers&lt;br&gt;• serves audit trails&lt;br&gt;• configures policies and reviews answers&lt;br&gt;[web ui]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-ui">
          <mxGeometry x="690" y="30" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ingestion" value="&lt;b&gt;Document ingestion&lt;/b&gt;&lt;br&gt;• loads PDF, DOCX, and scans with OCR fallback&lt;br&gt;• redacts personal data&lt;br&gt;• rejects OCR failures and malformed documents&lt;br&gt;• normalizes documents for indexing&lt;br&gt;[worker]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-backend">
          <mxGeometry x="60" y="40" width="460" height="250" as="geometry" />
        </mxCell>
        <mxCell id="embed-index" value="&lt;b&gt;Embedding and indexing&lt;/b&gt;&lt;br&gt;• splits documents into searchable passages&lt;br&gt;• stores passages, keywords, and permissions&lt;br&gt;• keeps cached embeddings&lt;br&gt;[worker]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-backend">
          <mxGeometry x="600" y="40" width="480" height="250" as="geometry" />
        </mxCell>
        <mxCell id="query-answer" value="&lt;b&gt;Query, answer, and streaming&lt;/b&gt;&lt;br&gt;• redacts personal data from questions and retrieves relevant passages with permission filtering, refusing permission-denied queries&lt;br&gt;• generates cited answers or an insufficient-context response on retrieval outage, model timeout, or budget exhaustion&lt;br&gt;• verifies answers with a retrieve → verify → answer loop&lt;br&gt;• streams answers and enforces rate limits and token budgets&lt;br&gt;• filters prompts and outputs against injection&lt;br&gt;[service]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-backend">
          <mxGeometry x="1120" y="40" width="460" height="250" as="geometry" />
        </mxCell>
        <mxCell id="doc-store" value="&lt;b&gt;Document store&lt;/b&gt;&lt;br&gt;• keeps raw uploaded documents&lt;br&gt;[object storage]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-repos">
          <mxGeometry x="60" y="40" width="460" height="100" as="geometry" />
        </mxCell>
        <mxCell id="search-index" value="&lt;b&gt;Search index&lt;/b&gt;&lt;br&gt;• keeps passages, keywords, permissions, and embedding cache&lt;br&gt;[vector db]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-repos">
          <mxGeometry x="600" y="40" width="480" height="100" as="geometry" />
        </mxCell>
        <mxCell id="audit-store" value="&lt;b&gt;Audit store&lt;/b&gt;&lt;br&gt;• keeps answers, sources, requesters, model and prompt versions, and token usage&lt;br&gt;[audit store]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-repos">
          <mxGeometry x="1120" y="40" width="460" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ext-embed" value="&lt;b&gt;Embedding model provider&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;makes text searchable by meaning" style="shape=mxgraph.c4.external;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
