<mxfile host="app.diagrams.net">
  <diagram id="retrieve-generate-stream" name="Retrieve generate stream">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2560" pageHeight="2445" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b style=&quot;font-size:16px&quot;&gt;C4 Level 2 - Retrieve, generate, cite, stream and authorize (step 3, v2, Draft)&lt;/b&gt;&lt;br&gt;Date: 2026-11-24&lt;br&gt;Requirements: FR-03, FR-04, FR-05, FR-06, FR-07, FR-08, NFR-01, NFR-02, NFR-03, NFR-05, NFR-06, NFR-07, NFR-08&lt;br&gt;Flow: employee → web app → API gateway (JWT, rate limit) → BFF (roles) → query preparation → retrieve &amp; rerank → context builder → answer worker → edge streaming service → gateway → SSE to the browser&lt;br&gt;Stores filled by steps 1 and 2 are marked in their text. The chat context lives only in the browser; there is no session store on the backend.&lt;br&gt;ADRs: reranker (API vs self-hosted), LLM hosting, gateway product, SSE vs WebSocket - none accepted yet" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="2000" height="100" as="geometry" />
        </mxCell>
        <mxCell id="sys-container" value="&lt;b style=&quot;font-size:15px&quot;&gt;Enterprise RAG knowledge assistant&lt;/b&gt;&lt;br&gt;[Software System]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F8FD;strokeColor=#6C8EBF;strokeWidth=2;verticalAlign=top;align=center;spacingTop=6;container=1;collapsible=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="110" width="1560" height="2175" as="geometry" />
        </mxCell>
        <mxCell id="grp-representation" value="&lt;b&gt;Representation&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;container=1;collapsible=0;fontSize=12;fontStyle=1;" vertex="1" parent="sys-container">
          <mxGeometry x="40" y="60" width="340" height="250" as="geometry" />
        </mxCell>
        <mxCell id="grp-backend" value="&lt;b&gt;Backend&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;container=1;collapsible=0;fontSize=12;fontStyle=1;" vertex="1" parent="sys-container">
          <mxGeometry x="1080" y="285" width="440" height="1850" as="geometry" />
        </mxCell>
        <mxCell id="grp-repos" value="&lt;b&gt;Repositories (DBs)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;container=1;collapsible=0;fontSize=12;fontStyle=1;" vertex="1" parent="sys-container">
          <mxGeometry x="460" y="410" width="400" height="1555" as="geometry" />
        </mxCell>
        <mxCell id="web-ui" value="&lt;b style=&quot;font-size:15px&quot;&gt;Web Application&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: web ui]&lt;/span&gt;&lt;br&gt;• asks questions and renders streamed tokens with clickable citations [1], [2]&lt;br&gt;• keeps the chat context (last turns) only in browser memory and sends it with every question; closing the tab discards it&lt;br&gt;• reconnects with Last-Event-ID; cancel button stops the answer&lt;br&gt;• sends helpful / not helpful feedback&lt;br&gt;• signs in through the IDP (OIDC) and holds the JWT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-representation">
          <mxGeometry x="30" y="35" width="280" height="200" as="geometry" />
        </mxCell>
        <mxCell id="api-gateway" value="&lt;b style=&quot;font-size:15px&quot;&gt;API gateway&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: api gateway]&lt;/span&gt;&lt;br&gt;• terminates TLS, load-balances, registers / deregisters service instances&lt;br&gt;• validates the JWT signature with the IDP public key and forwards the groups / roles claims as trusted headers&lt;br&gt;• per-user and per-tenant request rate limits (token bucket); answers 429 when exceeded&lt;br&gt;• relays the answer stream (SSE) from the edge streaming service to the browser" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="sys-container">
          <mxGeometry x="40" y="360" width="340" height="190" as="geometry" />
        </mxCell>
        <mxCell id="bff" value="&lt;b style=&quot;font-size:15px&quot;&gt;BFF service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: service]&lt;/span&gt;&lt;br&gt;• accepts the question, assigns chat id and message id&lt;br&gt;• maps the IDP groups forwarded by the gateway to application roles&lt;br&gt;• publishes the query message: question, chat context from the browser, user id, tenant, roles - never the JWT&lt;br&gt;• stores helpful / not helpful feedback for the evaluation set" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-backend">
          <mxGeometry x="40" y="40" width="360" height="175" as="geometry" />
        </mxCell>
        <mxCell id="prep" value="&lt;b style=&quot;font-size:15px&quot;&gt;Query preparation worker&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: worker]&lt;/span&gt;&lt;br&gt;• redacts personal data in the question and the chat context (regex + NER, no LLM): names become placeholders such as &amp;lt;Person_1&amp;gt;&lt;br&gt;• filters prompt-injection patterns&lt;br&gt;• turns a follow-up into a standalone question using the chat context from the message (no backend session)&lt;br&gt;• checks roles and tenant from the message; refuses queries the user may not run&lt;br&gt;• expands acronyms from the static glossary: BM25 gets the expanded terms, the embedding gets the definitions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-backend">
          <mxGeometry x="40" y="295" width="360" height="210" as="geometry" />
        </mxCell>
        <mxCell id="ret" value="&lt;b style=&quot;font-size:15px&quot;&gt;Retrieve &amp;amp; rerank worker&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: worker]&lt;/span&gt;&lt;br&gt;• embeds the query through the embedding provider&lt;br&gt;• hybrid search: BM25 + dense vectors in parallel, both filtered by tenant and allowed roles, fused into one list&lt;br&gt;• reranks the top k with a cross-encoder and keeps the best chunk per parent section&lt;br&gt;• below the score threshold: rewrites the query once with the LLM and retries; still low → insufficient context" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-backend">
          <mxGeometry x="40" y="585" width="360" height="320" as="geometry" />
        </mxCell>
        <mxCell id="ctx" value="&lt;b style=&quot;font-size:15px&quot;&gt;Context builder&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: worker]&lt;/span&gt;&lt;br&gt;• takes the ranked passages (or a denied / insufficient-context result)&lt;br&gt;• small-to-big: for each selected chunk fetches the previous chunk, the next chunk and the parent section header by id from the chunk store&lt;br&gt;• removes duplicates and overlaps, fits everything into the prompt context budget&lt;br&gt;• assembles the prompt: system instructions, domain rules, passages (placeholders only, no PII re-hydration)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-backend">
          <mxGeometry x="40" y="985" width="360" height="190" as="geometry" />
        </mxCell>
        <mxCell id="ans" value="&lt;b style=&quot;font-size:15px&quot;&gt;Answer worker&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: worker]&lt;/span&gt;&lt;br&gt;• checks the remaining token budget; exhausted → retrieval-only answer (cited passages, no LLM text)&lt;br&gt;• generates a cited answer with inline [1], [2], or an explicit &quot;insufficient context&quot; response&lt;br&gt;• agentic verify: a second LLM pass checks every claim against its cited passage; regenerates once or falls back to insufficient context&lt;br&gt;• filters the output and counts tokens; stops when a cancel event arrives&lt;br&gt;• publishes token, citation, done and error events; writes the audit record" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-backend">
          <mxGeometry x="40" y="1255" width="360" height="235" as="geometry" />
        </mxCell>
        <mxCell id="edge" value="&lt;b style=&quot;font-size:15px&quot;&gt;Edge streaming service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: service]&lt;/span&gt;&lt;br&gt;• dedicated streaming tier: holds the long-lived SSE connections so the gateway and BFF stay free for short requests&lt;br&gt;• authorizes each stream: only the user who asked the message may read it (identity forwarded by the gateway)&lt;br&gt;• subscribes to the answer events of the message (token, citation, done, error) and buffers them per message&lt;br&gt;• replays missed events when the browser reconnects with Last-Event-ID&lt;br&gt;• on client disconnect sends a cancel event to the answer worker&lt;br&gt;• token counter: adds the tokens reported on done to the user's usage and flags an exhausted budget" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-backend">
          <mxGeometry x="40" y="1570" width="360" height="240" as="geometry" />
        </mxCell>
        <mxCell id="feedback" value="&lt;b style=&quot;font-size:15px&quot;&gt;Feedback store&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: database]&lt;/span&gt;&lt;br&gt;• helpful / not helpful mark per answer id&lt;br&gt;• feeds the evaluation set and the regression suite (FR-08, EVAL-04)&lt;br&gt;• lifecycle: kept as long as the answer's audit record" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-repos">
          <mxGeometry x="40" y="20" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="pii" value="&lt;b style=&quot;font-size:15px&quot;&gt;PII mapping store&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: key-value store]&lt;/span&gt;&lt;br&gt;• maps names to placeholders such as &amp;lt;Person_1&amp;gt; (filled by step 1)&lt;br&gt;• identity vault, access-restricted" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-repos">
          <mxGeometry x="40" y="180" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="gloss" value="&lt;b style=&quot;font-size:15px&quot;&gt;Glossary store&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: key-value store]&lt;/span&gt;&lt;br&gt;• static acronym / abbreviation → definition and synonyms, O(1) lookup&lt;br&gt;• prepared from the area wiki and existing dictionaries, reviewed by engineers; no LLM involved&lt;br&gt;• lifecycle: versioned, changed through reviewed updates" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-repos">
          <mxGeometry x="40" y="310" width="320" height="130" as="geometry" />
        </mxCell>
        <mxCell id="vec" value="&lt;b style=&quot;font-size:15px&quot;&gt;Vector database&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: vector database]&lt;/span&gt;&lt;br&gt;• child-chunk vectors + permission metadata (filled by step 2)&lt;br&gt;• dense search with metadata filters (tenant, allowed roles)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-repos">
          <mxGeometry x="40" y="470" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="es" value="&lt;b style=&quot;font-size:15px&quot;&gt;Keyword search index&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: search engine]&lt;/span&gt;&lt;br&gt;• BM25 over the same child chunks with the same permission metadata (filled by step 2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-repos">
          <mxGeometry x="40" y="610" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="chunk" value="&lt;b style=&quot;font-size:15px&quot;&gt;Chunk store&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: key-value store]&lt;/span&gt;&lt;br&gt;• chunk id → text, parent id, previous id, next id, section path (filled by step 2)&lt;br&gt;• read by key for the neighbours and the parent section" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-repos">
          <mxGeometry x="40" y="870" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="audit" value="&lt;b style=&quot;font-size:15px&quot;&gt;Audit log&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: database]&lt;/span&gt;&lt;br&gt;• append-only record of every answer: redacted question, requester, retrieved sources, model + prompt version, verification result&lt;br&gt;• lifecycle: kept per compliance retention policy (to be defined)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-repos">
          <mxGeometry x="40" y="1140" width="320" height="130" as="geometry" />
        </mxCell>
        <mxCell id="quota" value="&lt;b style=&quot;font-size:15px&quot;&gt;Quota &amp;amp; usage store&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: key-value store]&lt;/span&gt;&lt;br&gt;• per-user and per-tenant LLM token budget and usage (written by the token counter)&lt;br&gt;• budget exhausted → retrieval-only mode (NFR-02)&lt;br&gt;• lifecycle: counters reset each budget period" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-repos">
          <mxGeometry x="40" y="1300" width="320" height="215" as="geometry" />
        </mxCell>
        <mxCell id="actor" value="&lt;span style=&quot;color:#ffffff;font-weight:bold;font-size:15px&quot;&gt;Employee&lt;/span&gt;&lt;br&gt;[Person]&lt;br&gt;• asks questions about policies, contracts and regulations" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#06315C;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="240" height="190" as="geometry" />
        </mxCell>
        <mxCell id="idp" value="&lt;b style=&quot;font-size:15px&quot;&gt;Corporate identity provider&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;register / login, federation; issues the JWT with groups and roles; publishes the public key (JWKS)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="240" height="180" as="geometry" />
        </mxCell>
        <mxCell id="embmodel" value="&lt;b style=&quot;font-size:15px&quot;&gt;Embedding model provider&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;embeds queries and chunks (same model as step 2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2200" y="970" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="rerank" value="&lt;b style=&quot;font-size:15px&quot;&gt;Reranking model provider&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;cross-encoder reranker: managed API or self-hosted (see ADR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2200" y="1080" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="llm" value="&lt;b style=&quot;font-size:15px&quot;&gt;Text generation model provider&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;query rewrite, answer generation and verification; private or API (see ADR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2200" y="1620" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="legend-1" value="&lt;b&gt;Legend&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;container=1;collapsible=0;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="340" height="390" as="geometry" />
        </mxCell>
        <mxCell id="legend-swatch-person" value="Person" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#06315C;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="legend-1">
          <mxGeometry x="15" y="34" width="120" height="32" as="geometry" />
        </mxCell>
        <mxCell id="legend-swatch-system" value="System boundary" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F8FD;strokeColor=#6C8EBF;strokeWidth=2;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="legend-1">
          <mxGeometry x="15" y="72" width="120" height="32" as="geometry" />
        </mxCell>
        <mxCell id="legend-swatch-external" value="External system" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="legend-1">
          <mxGeometry x="15" y="110" width="120" height="32" as="geometry" />
        </mxCell>
        <mxCell id="legend-swatch-ui" value="UI / API container" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="legend-1">
          <mxGeometry x="15" y="148" width="120" height="32" as="geometry" />
        </mxCell>
        <mxCell id="legend-swatch-service" value="Service / worker" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="legend-1">
          <mxGeometry x="15" y="186" width="120" height="32" as="geometry" />
        </mxCell>
        <mxCell id="legend-swatch-store" value="Data store" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="legend-1">
          <mxGeometry x="15" y="224" width="120" height="32" as="geometry" />
        </mxCell>
        <mxCell id="legend-sync-text" value="sync call [http / api]" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="legend-1">
          <mxGeometry x="150" y="266" width="180" height="24" as="geometry" />
        </mxCell>
        <mxCell id="legend-async-text" value="async [event / queue]" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="legend-1">
          <mxGeometry x="150" y="304" width="180" height="24" as="geometry" />
        </mxCell>
        <mxCell id="legend-jump-text" value="arc = lines cross, not connected" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="legend-1">
          <mxGeometry x="15" y="342" width="310" height="24" as="geometry" />
        </mxCell>
        <mxCell id="legend-e-sync" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="legend-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="15" y="278" as="sourcePoint" />
            <mxPoint x="135" y="278" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="legend-e-async" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;dashPattern=5 3;" edge="1" parent="legend-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="15" y="316" as="sourcePoint" />
            <mxPoint x="135" y="316" as="targetPoint" />
          </mxGeometry>
        </mxCell>


        <!-- ============ EDGES (explicit waypoints; data movers are labels, not boxes) ============ -->
        <mxCell id="e-ask" value="ask questions&#10;[https]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=1.0;exitY=0.4737;exitPerimeter=0;entryX=0.0;entryY=0.425;entryPerimeter=0;" edge="1" parent="1" source="actor" target="web-ui">
          <mxGeometry x="-0.3333" relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e-signin" value="sign in (OIDC)&#10;[https]" style="rounded=0;html=1;startArrow=block;startFill=1;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.0;exitY=0.875;exitPerimeter=0;entryX=1.0;entryY=0.3333;entryPerimeter=0;" edge="1" parent="1" source="web-ui" target="idp">
          <mxGeometry x="0.0303" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="380" y="380" />
              <mxPoint x="380" y="500" />
            </Array>
            <mxPoint x="-40" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e-question" value="submit question&#10;[https]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.3214;exitY=1.0;exitPerimeter=0;entryX=0.3529;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="web-ui" target="api-gateway">
          <mxGeometry x="-0.0154" relative="1" as="geometry">
            <mxPoint x="-70" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e-stream-web" value="answer stream&#10;[SSE over https]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;dashPattern=5 3;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.6765;exitY=0.0;exitPerimeter=0;entryX=0.7143;entryY=1.0;entryPerimeter=0;" edge="1" parent="1" source="api-gateway" target="web-ui">
          <mxGeometry x="0.0154" relative="1" as="geometry">
            <mxPoint x="80" y="0" as="offset" />
