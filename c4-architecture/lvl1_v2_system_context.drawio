<mxfile host="app.diagrams.net">
  <diagram id="lvl1-system-context" name="L1 System context">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;C4 Level 1 - Enterprise RAG knowledge assistant&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="actor-records" value="&lt;span style=&quot;color:#ffffff;font-weight:bold&quot;&gt;Records administrator&lt;/span&gt;&lt;br&gt;[Person]&lt;br&gt;• uploads documents through the UI&lt;br&gt;• tracks ingestion status" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#06315C;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="530" y="135" width="220" height="240" as="geometry" />
        </mxCell>
        <mxCell id="actor-employee" value="&lt;span style=&quot;color:#ffffff;font-weight:bold&quot;&gt;Employee&lt;/span&gt;&lt;br&gt;[Person]&lt;br&gt;• asks questions&lt;br&gt;• verifies answers with citations" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#06315C;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="790" y="134" width="220" height="240" as="geometry" />
        </mxCell>
        <mxCell id="actor-engineer" value="&lt;span style=&quot;color:#ffffff;font-weight:bold&quot;&gt;Engineer&lt;/span&gt;&lt;br&gt;[Person]&lt;br&gt;• defines access permissions&lt;br&gt;• reviews answer quality&lt;br&gt;• operates and monitors&lt;br&gt;• configures document and search quality" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#06315C;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1050" y="134" width="220" height="240" as="geometry" />
        </mxCell>
        <mxCell id="actor-compliance" value="&lt;span style=&quot;color:#ffffff;font-weight:bold&quot;&gt;Compliance officer&lt;/span&gt;&lt;br&gt;[Person]&lt;br&gt;• requests audit trails&lt;br&gt;• verifies answer provenance" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#06315C;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1310" y="134" width="220" height="240" as="geometry" />
        </mxCell>
        <mxCell id="system" value="&lt;b&gt;Enterprise RAG knowledge assistant&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;• ingests documents&lt;br&gt;• redacts personal data from documents and questions&lt;br&gt;• organizes documents for search&lt;br&gt;• finds relevant passages for each question&lt;br&gt;• answers questions with citations&lt;br&gt;• enforces access permissions&lt;br&gt;• declines to answer when evidence is insufficient&lt;br&gt;• records every answer for audit&lt;br&gt;• learns from feedback" style="shape=mxgraph.c4.system;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=3;fontColor=#333333;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="690" y="470" width="420" height="300" as="geometry" />
        </mxCell>
        <mxCell id="ext-embed" value="&lt;b&gt;Embedding model provider&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;makes text searchable by meaning" style="shape=mxgraph.c4.external;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="230" y="866" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="ext-rerank" value="&lt;b&gt;Reranking model provider&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;orders results by relevance" style="shape=mxgraph.c4.external;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
