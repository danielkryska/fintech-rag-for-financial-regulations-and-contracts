        <mxCell id="e-proc-coord" value="document.processed&#10;[event]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;dashPattern=5 3;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=1.0;exitY=0.15;exitPerimeter=0;entryX=0.0;entryY=0.8235;entryPerimeter=0;" edge="1" parent="1" source="proc" target="coord">
