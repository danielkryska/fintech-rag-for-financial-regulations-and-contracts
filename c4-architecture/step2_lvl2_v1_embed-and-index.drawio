        <!-- ============ EDGES (explicit waypoints; data movers are labels, not boxes) ============ -->
        <mxCell id="e-bld-llm" value="extract acronyms +&#10;definitions&#10;[https]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.0;exitY=0.375;exitPerimeter=0;entryX=1.0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="builder" target="llm">
