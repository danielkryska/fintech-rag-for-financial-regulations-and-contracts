          </mxGeometry>
        </mxCell>
        <mxCell id="e-enrich-gloss" value="look up acronyms&#10;[key-value read]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=1.0;exitY=0.3636;exitPerimeter=0;entryX=0.0;entryY=0.7857;entryPerimeter=0;" edge="1" parent="1" source="enrich" target="gloss">
          <mxGeometry x="-0.6667" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1100" y="670" />
              <mxPoint x="1100" y="310" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-embed-cache" value="reuse / store vectors&#10;[key-value read/write]" style="rounded=0;html=1;startArrow=block;startFill=1;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=1.0;exitY=0.3214;exitPerimeter=0;entryX=0.0;entryY=0.45;entryPerimeter=0;" edge="1" parent="1" source="embed" target="cache">
