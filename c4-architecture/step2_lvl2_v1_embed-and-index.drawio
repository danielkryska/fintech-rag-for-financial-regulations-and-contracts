        </mxCell>
        <mxCell id="e-writer-vec" value="upsert vectors + metadata&#10;[api call]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=1.0;exitY=0.2222;exitPerimeter=0;entryX=0.0;entryY=0.3077;entryPerimeter=0;" edge="1" parent="1" source="writer" target="vec">
          <mxGeometry x="0.0" relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e-writer-es" value="index chunk text&#10;[api call]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="writer" target="es">
          <mxGeometry x="-0.4468" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1160" y="1090" />
              <mxPoint x="1160" y="1200" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-writer-parent" value="store parent sections&#10;[key-value write]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=1.0;exitY=0.7778;exitPerimeter=0;entryX=0.0;entryY=0.5714;entryPerimeter=0;" edge="1" parent="1" source="writer" target="parent">
          <mxGeometry x="-0.5849" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1110" y="1140" />
              <mxPoint x="1110" y="1310" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
