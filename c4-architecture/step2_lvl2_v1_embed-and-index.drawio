        <mxCell id="e-enrich-proc" value="read chunks&#10;[s3 get]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.0;exitY=0.3636;exitPerimeter=0;entryX=1.0;entryY=0.8;entryPerimeter=0;" edge="1" parent="1" source="enrich" target="proc">
          <mxGeometry x="0.3077" relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e-enrich-embed" value="enriched chunks&#10;[queue]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;dashPattern=5 3;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.2353;exitY=1.0;exitPerimeter=0;entryX=0.2353;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="enrich" target="embed">
          <mxGeometry x="0.0" relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e-embed-model" value="embed chunks (batch)&#10;[http]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.0;exitY=0.3571;exitPerimeter=0;entryX=1.0;entryY=0.3077;entryPerimeter=0;" edge="1" parent="1" source="embed" target="embmodel">
          <mxGeometry x="0.3077" relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e-embed-writer" value="chunks + vectors&#10;[queue]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;dashPattern=5 3;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.2353;exitY=1.0;exitPerimeter=0;entryX=0.2353;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="embed" target="writer">
          <mxGeometry x="0.0" relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e-bld-gloss" value="seed / update definitions&#10;[key-value write]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=1.0;exitY=0.375;exitPerimeter=0;entryX=0.0;entryY=0.4286;entryPerimeter=0;" edge="1" parent="1" source="builder" target="gloss">
