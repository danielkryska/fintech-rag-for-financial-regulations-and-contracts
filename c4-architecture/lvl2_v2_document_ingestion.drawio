        <mxCell id="e-pii-processed" value="write anonymized&#10;chunked JSON&#10;[file write]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.375;exitY=1;exitPerimeter=0;entryX=0.9138;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="pii-worker" target="processed-store">
