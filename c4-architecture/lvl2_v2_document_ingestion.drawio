<mxfile host="app.diagrams.net">
  <diagram id="lvl2-ingestion" name="L2 Document ingestion">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="2000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b style=&quot;font-size:16px&quot;&gt;C4 Level 2 - Document ingestion (v2, Draft)&lt;/b&gt;&lt;br&gt;Date: 2026-11-18&lt;br&gt;Requirements: FR-01, NFR-03&lt;br&gt;Flow: Web UI → API GW → BFF → pre-signed upload → raw store → event bus → metadata DB → transformation → workers → processed store → indexing&lt;br&gt;ADRs: none accepted yet" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1100" height="90" as="geometry" />
        </mxCell>

        <!-- ===== Outside the system: person (above UI) and IDP (above API gateway) ===== -->
        <mxCell id="actor-records" value="&lt;span style=&quot;color:#ffffff;font-weight:bold&quot;&gt;Records administrator&lt;/span&gt;&lt;br&gt;[Person]&lt;br&gt;• uploads policy, contract, and regulatory documents" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#06315C;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="230" y="110" width="220" height="200" as="geometry" />
        </mxCell>
        <mxCell id="ext-idp" value="&lt;b&gt;Corporate identity provider&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;authenticates users, resolves groups and roles, embeds them in the JWT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="630" y="130" width="300" height="100" as="geometry" />
        </mxCell>

        <!-- ===== System boundary ===== -->
        <mxCell id="sys-container" value="&lt;b&gt;Enterprise RAG knowledge assistant&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F8FD;strokeColor=#6C8EBF;strokeWidth=2;verticalAlign=top;align=center;spacingTop=6;container=1;collapsible=0;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="390" width="1905" height="1200" as="geometry" />
        </mxCell>

        <!-- UI layer -->
        <mxCell id="grp-ui" value="&lt;b&gt;Web app UI&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;container=1;collapsible=0;fontSize=12;fontStyle=1;" vertex="1" parent="sys-container">
          <mxGeometry x="120" y="40" width="860" height="180" as="geometry" />
        </mxCell>
        <mxCell id="web-ui" value="&lt;b&gt;Web Application&lt;/b&gt;&lt;br&gt;• uploads documents via pre-signed URLs to the raw store&lt;br&gt;• shows ingestion status and rejections&lt;br&gt;• lists / edits document records through the BFF&lt;br&gt;[web ui]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-ui">
          <mxGeometry x="30" y="40" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="api-gateway" value="&lt;b&gt;API gateway&lt;/b&gt;&lt;br&gt;• receives upload and CRUD requests&lt;br&gt;• validates the JWT with the IDP and propagates groups/roles&lt;br&gt;• routes authenticated requests to the BFF&lt;br&gt;[api gateway]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-ui">
          <mxGeometry x="460" y="40" width="320" height="120" as="geometry" />
        </mxCell>

        <!-- Backend layer -->
        <mxCell id="grp-backend" value="&lt;b&gt;Backend&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;container=1;collapsible=0;fontSize=12;fontStyle=1;" vertex="1" parent="sys-container">
          <mxGeometry x="120" y="330" width="1745" height="360" as="geometry" />
        </mxCell>
        <mxCell id="bff" value="&lt;b&gt;BFF service&lt;/b&gt;&lt;br&gt;• generates pre-signed upload URLs for the raw store&lt;br&gt;• CRUD for document records (metadata + raw pointer)&lt;br&gt;• enforces RBAC using JWT group/role claims&lt;br&gt;[bff]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-backend">
          <mxGeometry x="30" y="130" width="200" height="210" as="geometry" />
        </mxCell>
        <mxCell id="event-bus" value="&lt;b&gt;Event bus&lt;/b&gt;&lt;br&gt;• transport for document.uploaded / document.processed&lt;br&gt;• decouples storage, metadata, and processing&lt;br&gt;[message broker]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-backend">
          <mxGeometry x="260" y="130" width="200" height="210" as="geometry" />
        </mxCell>
        <mxCell id="orchestrator" value="&lt;b&gt;Transformation orchestrator&lt;/b&gt;&lt;br&gt;• consumes processing triggers&lt;br&gt;• dispatches the right worker per file type&lt;br&gt;• validates documents and rejects malformed / poisoned input&lt;br&gt;• tracks status on metadata records&lt;br&gt;[orchestrator]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-backend">
          <mxGeometry x="490" y="130" width="200" height="210" as="geometry" />
        </mxCell>
        <mxCell id="docx-worker" value="&lt;b&gt;DOCX extractor worker&lt;/b&gt;&lt;br&gt;• extracts text from DOCX documents&lt;br&gt;• chunks text by hierarchy&lt;br&gt;• writes chunks to temp storage&lt;br&gt;[worker]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-backend">
          <mxGeometry x="720" y="130" width="200" height="210" as="geometry" />
        </mxCell>
        <mxCell id="pdf-worker" value="&lt;b&gt;PDF extractor worker&lt;/b&gt;&lt;br&gt;• extracts text from PDFs&lt;br&gt;• chunks text by hierarchy (chapters / sections)&lt;br&gt;• falls back to the OCR worker if text extraction fails&lt;br&gt;• writes chunks to temp storage&lt;br&gt;[worker]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-backend">
          <mxGeometry x="950" y="130" width="200" height="210" as="geometry" />
        </mxCell>
        <mxCell id="ocr-worker" value="&lt;b&gt;Image / OCR worker&lt;/b&gt;&lt;br&gt;• converts scanned pages and embedded PDF images to text&lt;br&gt;• chunks text by hierarchy&lt;br&gt;• also consumes image-processing events from the processed store&lt;br&gt;[worker]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-backend">
          <mxGeometry x="1265" y="130" width="200" height="210" as="geometry" />
        </mxCell>
        <mxCell id="pii-worker" value="&lt;b&gt;PII redaction &amp; chunk writer&lt;/b&gt;&lt;br&gt;• detects and redacts personal data&lt;br&gt;• writes anonymized chunked JSON with placeholders such as &amp;lt;person 1&amp;gt; only&lt;br&gt;• writes the real-&amp;gt;placeholder mapping to the PII store&lt;br&gt;[worker]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-backend">
          <mxGeometry x="1515" y="130" width="200" height="210" as="geometry" />
        </mxCell>

        <!-- Repositories -->
        <mxCell id="grp-repos" value="&lt;b&gt;Repositories (DBs)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;container=1;collapsible=0;fontSize=12;fontStyle=1;" vertex="1" parent="sys-container">
          <mxGeometry x="120" y="920" width="1745" height="240" as="geometry" />
        </mxCell>
        <mxCell id="raw-store" value="&lt;b&gt;Raw document store&lt;/b&gt;&lt;br&gt;• keeps original uploaded documents&lt;br&gt;• emits document.uploaded to the event bus&lt;br&gt;[object storage]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-repos">
          <mxGeometry x="40" y="50" width="270" height="170" as="geometry" />
        </mxCell>
        <mxCell id="meta-store" value="&lt;b&gt;Document metadata store&lt;/b&gt;&lt;br&gt;• document id, type, status, permissions&lt;br&gt;• receives file meta from the event consumer and triggers processing&lt;br&gt;[key-value store]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-repos">
          <mxGeometry x="350" y="50" width="250" height="170" as="geometry" />
        </mxCell>
        <mxCell id="temp-store" value="&lt;b&gt;Temp artifact storage&lt;/b&gt;&lt;br&gt;• keeps intermediate PDF, OCR, and DOCX chunk artifacts&lt;br&gt;[object storage]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-repos">
          <mxGeometry x="840" y="50" width="300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="processed-store" value="&lt;b&gt;Processed document store&lt;/b&gt;&lt;br&gt;• keeps anonymized chunked JSON; only &amp;lt;person 1&amp;gt; style placeholders&lt;br&gt;• emits document.processed events to the indexing slice&lt;br&gt;• emits image-processing events for images embedded in PDFs&lt;br&gt;[object storage]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-repos">
          <mxGeometry x="1180" y="50" width="290" height="170" as="geometry" />
        </mxCell>
        <mxCell id="pii-store" value="&lt;b&gt;PII mapping store&lt;/b&gt;&lt;br&gt;• keeps real user personal data mapped to placeholders&lt;br&gt;• identity vault, access-restricted&lt;br&gt;[key-value store]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-repos">
          <mxGeometry x="1520" y="50" width="200" height="170" as="geometry" />
        </mxCell>

        <!-- External consumer of document.processed -->
        <mxCell id="slice-embed" value="&lt;b&gt;Embedding and indexing slice&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;consumes document.processed events" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1250" y="1680" width="400" height="80" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend-1" value="&lt;b&gt;Legend&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;container=1;collapsible=0;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1830" width="1300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="legend-swatch-person" value="Person" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#06315C;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="legend-1">
          <mxGeometry x="15" y="30" width="90" height="40" as="geometry" />
        </mxCell>
        <mxCell id="legend-swatch-system" value="System boundary" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F8FD;strokeColor=#6C8EBF;strokeWidth=2;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="legend-1">
          <mxGeometry x="120" y="30" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="legend-swatch-external" value="External system" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="legend-1">
          <mxGeometry x="265" y="30" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="legend-swatch-ui" value="UI / API" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="legend-1">
          <mxGeometry x="400" y="30" width="110" height="40" as="geometry" />
        </mxCell>
        <mxCell id="legend-swatch-service" value="Service / worker" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="legend-1">
          <mxGeometry x="525" y="30" width="110" height="40" as="geometry" />
        </mxCell>
        <mxCell id="legend-swatch-store" value="Data store" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="legend-1">
          <mxGeometry x="650" y="30" width="110" height="40" as="geometry" />
        </mxCell>
        <mxCell id="legend-sync-text" value="sync" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="legend-1">
          <mxGeometry x="860" y="38" width="50" height="24" as="geometry" />
        </mxCell>
        <mxCell id="legend-async-text" value="async" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="legend-1">
          <mxGeometry x="1000" y="38" width="50" height="24" as="geometry" />
        </mxCell>
        <mxCell id="legend-jump-text" value="arc = lines cross, not connected" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="legend-1">
          <mxGeometry x="1070" y="38" width="220" height="24" as="geometry" />
        </mxCell>
        <mxCell id="legend-e-sync" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="legend-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="790" y="50" as="sourcePoint" />
            <mxPoint x="850" y="50" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="legend-e-async" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;dashPattern=5 3;" edge="1" parent="legend-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="930" y="50" as="sourcePoint" />
            <mxPoint x="990" y="50" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ============ EDGES (explicit waypoints; every segment runs in a gap between boxes) ============ -->

        <!-- Person -> Web UI -->
        <mxCell id="e-upload" value="upload documents&#10;[http]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="actor-records" target="web-ui">
          <mxGeometry x="-0.5" relative="1" as="geometry">
            <mxPoint x="75" y="0" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Web UI -> API gateway -->
        <mxCell id="e-send" value="submit / CRUD&#10;[http]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="web-ui" target="api-gateway">
          <mxGeometry x="0" relative="1" as="geometry" />
        </mxCell>

        <!-- API gateway -> IDP (straight up, outside the system) -->
        <mxCell id="e-auth" value="validate token, fetch groups/roles&#10;[http]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=0;exitPerimeter=0;entryX=0.5;entryY=1;entryPerimeter=0;" edge="1" parent="1" source="api-gateway" target="ext-idp">
          <mxGeometry x="0.3333" relative="1" as="geometry">
            <mxPoint x="120" y="0" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- API gateway -> BFF (gap between UI and Backend layers) -->
        <mxCell id="e-route" value="route with JWT&#10;[http]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.55;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="api-gateway" target="bff">
          <mxGeometry x="-0.1892" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="780" y="650" />
              <mxPoint x="300" y="650" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Web UI -> Raw store (upload via pre-signed URL; runs down the left margin, outside all layers) -->
        <mxCell id="e-web-upload" value="upload via&#10;pre-signed URL&#10;[https]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=0;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="web-ui" target="raw-store">
          <mxGeometry x="-0.6018" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="100" y="530" />
              <mxPoint x="100" y="1445" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- BFF -> Raw store (generate pre-signed URL) -->
        <mxCell id="e-presign" value="generate pre-signed URL&#10;[api call]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.3;exitY=1;exitPerimeter=0;entryX=0.1852;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="bff" target="raw-store">
          <mxGeometry x="0.1667" relative="1" as="geometry" />
        </mxCell>

        <!-- BFF -> Metadata store (CRUD) -->
        <mxCell id="e-crud" value="CRUD document records&#10;[key-value read/write]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.8;exitY=1;exitPerimeter=0;entryX=0.14;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="bff" target="meta-store">
          <mxGeometry x="-0.8182" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="350" y="1150" />
              <mxPoint x="545" y="1150" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Raw store -> Event bus -->
        <mxCell id="e-raw-event" value="document.uploaded&#10;[event]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;dashPattern=5 3;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.9259;exitY=0;exitPerimeter=0;entryX=0.15;entryY=1;entryPerimeter=0;" edge="1" parent="1" source="raw-store" target="event-bus">
          <mxGeometry x="-0.3333" relative="1" as="geometry" />
        </mxCell>

        <!-- Event bus -> Metadata store (consumer persists meta) -->
        <mxCell id="e-event-meta" value="persist file meta&#10;[event]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;dashPattern=5 3;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.85;exitY=1;exitPerimeter=0;entryX=0.32;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="event-bus" target="meta-store">
          <mxGeometry x="-0.6667" relative="1" as="geometry" />
        </mxCell>

        <!-- Metadata store -> Orchestrator (trigger) -->
        <mxCell id="e-trigger" value="processing trigger&#10;[change event]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;dashPattern=5 3;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.76;exitY=0;exitPerimeter=0;entryX=0.25;entryY=1;entryPerimeter=0;" edge="1" parent="1" source="meta-store" target="orchestrator">
          <mxGeometry x="-0.2667" relative="1" as="geometry" />
        </mxCell>

        <!-- Orchestrator -> workers (shared trunk above the worker row, one drop per worker) -->
        <mxCell id="e-docx" value="extract DOCX&#10;[queue]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;dashPattern=5 3;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=0;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="orchestrator" target="docx-worker">
          <mxGeometry x="0.8286" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="750" y="790" />
              <mxPoint x="980" y="790" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-pdf" value="extract PDF&#10;[queue]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;dashPattern=5 3;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=0;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="orchestrator" target="pdf-worker">
          <mxGeometry x="0.8966" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="750" y="790" />
              <mxPoint x="1210" y="790" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-ocr" value="run OCR&#10;[queue]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;dashPattern=5 3;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=0;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="orchestrator" target="ocr-worker">
          <mxGeometry x="0.933" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="750" y="790" />
              <mxPoint x="1525" y="790" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-pii" value="redact PII + write chunks&#10;[queue]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;dashPattern=5 3;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=0;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="orchestrator" target="pii-worker">
          <mxGeometry x="0.9476" relative="1" as="geometry">
