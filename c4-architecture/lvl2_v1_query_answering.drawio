        </mxCell>
        <mxCell id="grp-ui" value="&lt;b&gt;Web app UI&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;container=1;collapsible=0;fontSize=12;fontStyle=1;" vertex="1" parent="sys-container">
          <mxGeometry x="40" y="40" width="1640" height="130" as="geometry" />
        </mxCell>
        <mxCell id="grp-backend" value="&lt;b&gt;Backend&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;container=1;collapsible=0;fontSize=12;fontStyle=1;" vertex="1" parent="sys-container">
          <mxGeometry x="40" y="200" width="1640" height="330" as="geometry" />
        </mxCell>
        <mxCell id="grp-repos" value="&lt;b&gt;Repositories (DBs)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;container=1;collapsible=0;fontSize=12;fontStyle=1;" vertex="1" parent="sys-container">
          <mxGeometry x="40" y="560" width="1640" height="180" as="geometry" />
        </mxCell>
        <mxCell id="web-ui" value="&lt;b&gt;Web Application&lt;/b&gt;&lt;br&gt;• asks questions in the browser&lt;br&gt;• shows streamed answers with citations&lt;br&gt;• serves audit trails and review tools&lt;br&gt;[web ui]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-ui">
          <mxGeometry x="480" y="30" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="api-gateway" value="&lt;b&gt;API gateway&lt;/b&gt;&lt;br&gt;• streams answer tokens to the browser&lt;br&gt;• cancels streams on disconnect&lt;br&gt;• enforces per-user rate limits&lt;br&gt;[api gateway]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-ui">
          <mxGeometry x="980" y="30" width="480" height="70" as="geometry" />
        </mxCell>
        <mxCell id="query-service" value="&lt;b&gt;Query, answer, and streaming service&lt;/b&gt;&lt;br&gt;• redacts personal data from questions&lt;br&gt;• retrieves relevant passages with permission filtering, refusing permission-denied queries&lt;br&gt;• builds the context and prompt from retrieved passages&lt;br&gt;• generates cited answers or an insufficient-context response on retrieval outage, model timeout, or budget exhaustion&lt;br&gt;• verifies answers with a retrieve → verify → answer loop, one tool call, and tool registration&lt;br&gt;• filters prompts and outputs against injection&lt;br&gt;• reads audit trails for the compliance officer&lt;br&gt;[service]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-backend">
          <mxGeometry x="920" y="40" width="680" height="250" as="geometry" />
        </mxCell>
        <mxCell id="search-index" value="&lt;b&gt;Search index&lt;/b&gt;&lt;br&gt;• keeps passages, keywords, permissions, and the embedding cache&lt;br&gt;[vector db]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-repos">
          <mxGeometry x="60" y="40" width="600" height="100" as="geometry" />
        </mxCell>
        <mxCell id="audit-store" value="&lt;b&gt;Audit store&lt;/b&gt;&lt;br&gt;• keeps answers, sources, requesters, model and prompt versions, and token usage&lt;br&gt;[audit store]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-repos">
          <mxGeometry x="920" y="40" width="680" height="100" as="geometry" />
        </mxCell>
