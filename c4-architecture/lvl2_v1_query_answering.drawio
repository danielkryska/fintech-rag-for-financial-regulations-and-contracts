<mxfile host="app.diagrams.net">
  <diagram id="lvl2-query" name="L2 Query answering streaming">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1520" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;C4 Level 2 - Query, answer, and streaming (v1, Draft)&lt;/b&gt;&lt;br&gt;Date: 2026-11-18&lt;br&gt;Requirements: FR-03 to FR-07, NFR-01, NFR-02, NFR-03, NFR-05 to NFR-08&lt;br&gt;ADRs: none accepted yet" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1100" height="70" as="geometry" />
        </mxCell>
        <mxCell id="actor-employee" value="&lt;span style=&quot;color:#ffffff;font-weight:bold&quot;&gt;Employee&lt;/span&gt;&lt;br&gt;[Person]&lt;br&gt;• asks questions&lt;br&gt;• reads streamed answers" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#06315C;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
