        </mxCell>
        <mxCell id="actor-compliance" value="&lt;span style=&quot;color:#ffffff;font-weight:bold&quot;&gt;Compliance officer&lt;/span&gt;&lt;br&gt;[Person]&lt;br&gt;• requests audit trails" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#06315C;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="930" y="134" width="220" height="240" as="geometry" />
        </mxCell>
        <mxCell id="actor-engineer" value="&lt;span style=&quot;color:#ffffff;font-weight:bold&quot;&gt;Engineer&lt;/span&gt;&lt;br&gt;[Person]&lt;br&gt;• defines policies&lt;br&gt;• reviews answers" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#06315C;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1210" y="134" width="220" height="240" as="geometry" />
        </mxCell>
        <mxCell id="sys-container" value="&lt;b&gt;Enterprise RAG knowledge assistant&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;container=1;collapsible=0;fontSize=14;fontStyle=1;" vertex="1" parent="1">
