<mxfile host="app.diagrams.net">
  <diagram id="retrieve-generate-stream" name="Retrieve generate stream">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2700" pageHeight="4040" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b style=&quot;font-size:16px&quot;&gt;C4 Level 2 - Retrieve, generate, cite, stream and authorize (step 3, v5, Draft)&lt;/b&gt;&lt;br&gt;Date: 2026-11-26&lt;br&gt;Requirements: FR-03, FR-04, FR-05, FR-06, FR-07, FR-08, NFR-01, NFR-02, NFR-03, NFR-05, NFR-06, NFR-07, NFR-08&lt;br&gt;Question path: employee → web app → API gateway (JWT, rate limit) → BFF (limits, quota, roles, intake audit) → query preparation (PII → placeholders) → retrieve &amp; rerank → context builder → answer worker (structured output, final audit)&lt;br&gt;Answer path: answer worker → PII re-hydration (key lookup, buffered streaming matcher) → edge streaming service → browser, directly over SSE (not through the gateway, 30 s timeout; not through the BFF). The edge service validates the JWT with the IDP public key and checks the quota itself.&lt;br&gt;PII: detected with rules + NER model + entity linking by hybrid search over the registry (step 1 does the same for documents); the LLM never detects or sees PII. Yellow notes show example records (illustrative values). The chat context lives only in the browser.&lt;br&gt;ADRs: reranker, LLM hosting, gateway product, SSE vs WebSocket, complexity rules, PII visibility rules, PII redaction scope when models are internal or run in the cloud account (Bedrock) - none accepted yet" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="2300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="sys-container" value="&lt;b style=&quot;font-size:15px&quot;&gt;Enterprise RAG knowledge assistant&lt;/b&gt;&lt;br&gt;[Software System]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F8FD;strokeColor=#6C8EBF;strokeWidth=2;verticalAlign=top;align=center;spacingTop=6;container=1;collapsible=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="120" width="1560" height="3800" as="geometry" />
        </mxCell>
        <mxCell id="grp-representation" value="&lt;b&gt;Representation&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;container=1;collapsible=0;fontSize=12;fontStyle=1;" vertex="1" parent="sys-container">
          <mxGeometry x="40" y="50" width="340" height="285" as="geometry" />
        </mxCell>
        <mxCell id="grp-backend" value="&lt;b&gt;Backend&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;container=1;collapsible=0;fontSize=12;fontStyle=1;" vertex="1" parent="sys-container">
          <mxGeometry x="1080" y="335" width="440" height="3425" as="geometry" />
        </mxCell>
        <mxCell id="grp-repos" value="&lt;b&gt;Repositories (DBs)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;container=1;collapsible=0;fontSize=12;fontStyle=1;" vertex="1" parent="sys-container">
          <mxGeometry x="520" y="460" width="400" height="2080" as="geometry" />
        </mxCell>
        <mxCell id="web-ui" value="&lt;b style=&quot;font-size:15px&quot;&gt;Web Application&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: web ui]&lt;/span&gt;&lt;br&gt;• asks questions and renders streamed tokens with clickable citations [1], [2]&lt;br&gt;• shows the user's remaining quota and usage&lt;br&gt;• keeps the chat context (last turns) only in browser memory and sends it with every question; closing the tab discards it&lt;br&gt;• opens the answer stream directly on the edge streaming service (JWT + message id), not through the gateway; reconnects with Last-Event-ID; cancel button stops the answer&lt;br&gt;• sends helpful / not helpful feedback&lt;br&gt;• signs in through the IDP (OIDC) and holds the JWT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-representation">
          <mxGeometry x="30" y="35" width="280" height="240" as="geometry" />
        </mxCell>
        <mxCell id="api-gateway" value="&lt;b style=&quot;font-size:15px&quot;&gt;API gateway&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: api gateway]&lt;/span&gt;&lt;br&gt;• terminates TLS, load-balances, registers / deregisters service instances&lt;br&gt;• validates the JWT signature with the IDP public key and forwards the groups / roles claims as trusted headers&lt;br&gt;• per-user and per-tenant request rate limits (token bucket); answers 429 when exceeded&lt;br&gt;• closes any request that runs longer than 30 s, so it carries only short request / response calls; long-lived answer streams do not pass through it" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="sys-container">
          <mxGeometry x="40" y="390" width="340" height="190" as="geometry" />
        </mxCell>
        <mxCell id="bff" value="&lt;b style=&quot;font-size:15px&quot;&gt;BFF service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: service]&lt;/span&gt;&lt;br&gt;• accepts the question, assigns chat id and message id and returns the message id to the browser (the answer arrives on the stream)&lt;br&gt;• maps the IDP groups forwarded by the gateway to application roles&lt;br&gt;• validates the hard limits before any work: question length, size of the chat context, request format; rejects with 4xx&lt;br&gt;• checks the user's token budget and usage in the quota store before processing; exhausted → marks the query retrieval-only&lt;br&gt;• writes the intake audit record (user, tenant, roles, validation and quota decisions) before the query is published, also for rejected requests&lt;br&gt;• publishes the query message: question, chat context from the browser, user id, tenant, roles, mode - never the JWT&lt;br&gt;• returns the user's quota and usage when the UI asks&lt;br&gt;• stores helpful / not helpful feedback for the evaluation set" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-backend">
          <mxGeometry x="40" y="40" width="360" height="775" as="geometry" />
        </mxCell>
        <mxCell id="prep" value="&lt;b style=&quot;font-size:15px&quot;&gt;Query preparation worker&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: worker]&lt;/span&gt;&lt;br&gt;• finds personal data in the question and the chat context in three layers, no LLM: rules for structured values (IBAN, e-mail, phone), an NER model for names and addresses, and entity linking against the PII entity registry&lt;br&gt;• entity linking: each mention is looked up in the registry by hybrid search (BM25 with fuzzy match on aliases + embedding of the mention with its context), so &quot;Kowalski&quot; and &quot;J. Kowalski&quot; resolve to the same key&lt;br&gt;• replaces every mention with the typed placeholder of its registry key, e.g. &amp;lt;Person_17&amp;gt;; an unknown name gets a temporary key valid for this message only&lt;br&gt;• passes the resolved entity ids to retrieval: chunks were stored with the same placeholders and entity ids, so the match works on the key, not on the spelling&lt;br&gt;• filters prompt-injection patterns&lt;br&gt;• validates complexity and scope against the system limits (sub-questions, entities, expanded query size); refuses over-limit or out-of-scope questions with a reason and a hint to split them&lt;br&gt;• turns a follow-up into a standalone question using the chat context from the message (no backend session)&lt;br&gt;• checks roles and tenant from the message; refuses queries the user may not run&lt;br&gt;• expands acronyms from the static glossary: BM25 gets the expanded terms, the embedding gets the definitions&lt;br&gt;• appends its decisions (redaction counts, refusals, injection hits) to the audit trail of the message" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-backend">
          <mxGeometry x="40" y="945" width="360" height="430" as="geometry" />
        </mxCell>
        <mxCell id="ret" value="&lt;b style=&quot;font-size:15px&quot;&gt;Retrieve &amp;amp; rerank worker&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: worker]&lt;/span&gt;&lt;br&gt;• embeds the query through the embedding provider (placeholders stay in the text)&lt;br&gt;• hybrid search: BM25 + dense vectors in parallel, both filtered by tenant and allowed roles; the resolved entity ids boost chunks that mention the same entity; results fused into one list&lt;br&gt;• reranks the top k with a cross-encoder and keeps the best chunk per parent section&lt;br&gt;• below the score threshold: rewrites the query once with the LLM and retries; still low → insufficient context&lt;br&gt;• adds the filters applied and the retrieved chunk ids to the audit trail" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-backend">
          <mxGeometry x="40" y="1505" width="360" height="320" as="geometry" />
        </mxCell>
        <mxCell id="ctx" value="&lt;b style=&quot;font-size:15px&quot;&gt;Context builder&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: worker]&lt;/span&gt;&lt;br&gt;• takes the ranked passages (or a denied / insufficient-context result)&lt;br&gt;• small-to-big: for each selected chunk fetches the previous chunk, the next chunk and the parent section header by id from the chunk store&lt;br&gt;• removes duplicates and overlaps, fits everything into the prompt context budget&lt;br&gt;• collects the placeholder keys that occur in the question and the passages: they are the only keys the answer may contain&lt;br&gt;• assembles the prompt: system instructions, domain rules, passages and the key list (placeholders only, the LLM never sees real names)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-backend">
          <mxGeometry x="40" y="1945" width="360" height="230" as="geometry" />
        </mxCell>
        <mxCell id="ans" value="&lt;b style=&quot;font-size:15px&quot;&gt;Answer worker&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: worker]&lt;/span&gt;&lt;br&gt;• follows the mode set by the BFF: retrieval-only → returns the cited passages without LLM text&lt;br&gt;• prompt rule: copy placeholders exactly as given, never invent, translate, shorten or reformat them&lt;br&gt;• asks for structured output: JSON with answer segments and citation ids; a placeholder must be one of the allowed keys (enum in the schema); a provider without constrained decoding gets schema validation + one retry&lt;br&gt;• output validator: an unknown or invented placeholder, a malformed one, or a PII-like string (name, IBAN, e-mail) in the text → regenerates once, then insufficient context&lt;br&gt;• agentic verify: a second LLM pass checks every claim against its cited passage; regenerates once or falls back to insufficient context&lt;br&gt;• counts tokens, stops when a cancel event arrives; streams the text of the answer segments as token, citation, done and error events (still with placeholders)&lt;br&gt;• writes the final audit record for every outcome (answered, denied, insufficient context, retrieval-only, cancelled, failed)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-backend">
          <mxGeometry x="40" y="2265" width="360" height="330" as="geometry" />
        </mxCell>
        <mxCell id="rehyd" value="&lt;b style=&quot;font-size:15px&quot;&gt;PII re-hydration worker&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: worker]&lt;/span&gt;&lt;br&gt;• consumes the answer events (token, citation, done, error) that still contain placeholders such as &amp;lt;Person_17&amp;gt;&lt;br&gt;• looks up the real values by key, never by text search: one batch read for all keys of the message, kept in memory for that message only, so each token is a hash lookup&lt;br&gt;• streaming matcher: holds back text from &quot;&amp;lt;&quot; until the closing &quot;&amp;gt;&quot; (max length, timeout flush), so a placeholder split over two chunks (&quot;&amp;lt;Per&quot; + &quot;son_17&amp;gt;&quot;) is replaced once it is complete&lt;br&gt;• replaces a value only where the requester's roles allow it (roles from the event); an unknown key or a denied role stays a placeholder&lt;br&gt;• forwards the re-hydrated events to the edge streaming service; the LLM provider and the audit log only ever see placeholders&lt;br&gt;• relays cancel events from the edge streaming service to the answer worker" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-backend">
          <mxGeometry x="40" y="2685" width="360" height="270" as="geometry" />
        </mxCell>
        <mxCell id="edge" value="&lt;b style=&quot;font-size:15px&quot;&gt;Edge streaming service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: service]&lt;/span&gt;&lt;br&gt;• internet-facing streaming tier: the browser connects directly over SSE, not through the gateway (30 s timeout) or the BFF&lt;br&gt;• validates the user's JWT itself with the IDP public key (JWKS), fetched from the IDP and cached in memory for a few minutes&lt;br&gt;• authorizes each stream: the user in the token must be the asker of the message&lt;br&gt;• checks the user's quota when a stream opens and limits open streams per user (no gateway in front)&lt;br&gt;• subscribes to the re-hydrated answer events of the message and buffers them per message; replays missed events on Last-Event-ID&lt;br&gt;• on client disconnect sends a cancel event towards the answer worker&lt;br&gt;• token counter: adds the tokens reported on done to the user's usage in the quota store" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-backend">
          <mxGeometry x="40" y="3045" width="360" height="340" as="geometry" />
        </mxCell>
        <mxCell id="quota" value="&lt;b style=&quot;font-size:15px&quot;&gt;Quota &amp;amp; usage store&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: key-value store]&lt;/span&gt;&lt;br&gt;• per-user and per-tenant LLM token budget and usage&lt;br&gt;• read by the BFF before every query and when the user asks for quota and usage; read by the Edge service when a stream opens&lt;br&gt;• usage written by the Edge token counter; budget exhausted → retrieval-only mode (NFR-02)&lt;br&gt;• lifecycle: counters reset each budget period" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-repos">
          <mxGeometry x="40" y="20" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="note-quota" value="&lt;b style=&quot;font-size:10px&quot;&gt;Example quota record (illustrative)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Courier New;font-size:10px&quot;&gt;{ &amp;quot;user&amp;quot;: &amp;quot;u-1017&amp;quot;, &amp;quot;period&amp;quot;: &amp;quot;2026-11&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;tokenBudget&amp;quot;: 400000, &amp;quot;used&amp;quot;: 128450,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;openStreams&amp;quot;: 1, &amp;quot;mode&amp;quot;: &amp;quot;normal&amp;quot; }&lt;/span&gt;" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#FFF8DC;strokeColor=#B8A04A;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;spacingRight=2;spacing=0;" vertex="1" parent="grp-repos">
          <mxGeometry x="40" y="180" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="audit" value="&lt;b style=&quot;font-size:15px&quot;&gt;Audit log&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: database]&lt;/span&gt;&lt;br&gt;• append-only, correlated by message id; redacted question only&lt;br&gt;• intake record from the BFF (before processing, also for rejected requests) + final record from the Answer worker (outcome, sources, model + prompt version, verification, tokens, stage trail)&lt;br&gt;• lifecycle: kept per compliance retention policy (to be defined)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-repos">
          <mxGeometry x="40" y="280" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="note-audit" value="&lt;b style=&quot;font-size:10px&quot;&gt;Example audit records (illustrative)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Courier New;font-size:10px&quot;&gt;{ &amp;quot;msgId&amp;quot;: &amp;quot;m-8841&amp;quot;, &amp;quot;stage&amp;quot;: &amp;quot;intake&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;user&amp;quot;: &amp;quot;u-1017&amp;quot;, &amp;quot;decision&amp;quot;: &amp;quot;accepted&amp;quot; }&lt;br&gt;{ &amp;quot;msgId&amp;quot;: &amp;quot;m-8841&amp;quot;, &amp;quot;stage&amp;quot;: &amp;quot;final&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;outcome&amp;quot;: &amp;quot;answered&amp;quot;, &amp;quot;tokens&amp;quot;: 1840,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;question&amp;quot;: &amp;quot;What did &amp;lt;Person_17&amp;gt; agree?&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;sources&amp;quot;: [&amp;quot;doc42@v3:c32&amp;quot;],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;model&amp;quot;: &amp;quot;llm-x@2026-11&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;trail&amp;quot;: [&amp;quot;pii:1&amp;quot;, &amp;quot;filters:ok&amp;quot;, &amp;quot;verify:ok&amp;quot;] }&lt;/span&gt;" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#FFF8DC;strokeColor=#B8A04A;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;spacingRight=2;spacing=0;" vertex="1" parent="grp-repos">
          <mxGeometry x="40" y="450" width="320" height="140" as="geometry" />
        </mxCell>
        <mxCell id="feedback" value="&lt;b style=&quot;font-size:15px&quot;&gt;Feedback store&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: database]&lt;/span&gt;&lt;br&gt;• helpful / not helpful mark per answer id&lt;br&gt;• feeds the evaluation set and the regression suite (FR-08, EVAL-04)&lt;br&gt;• lifecycle: kept as long as the answer's audit record" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-repos">
          <mxGeometry x="40" y="620" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="note-feedback" value="&lt;b style=&quot;font-size:10px&quot;&gt;Example feedback record (illustrative)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Courier New;font-size:10px&quot;&gt;{ &amp;quot;msgId&amp;quot;: &amp;quot;m-8841&amp;quot;, &amp;quot;mark&amp;quot;: &amp;quot;not_helpful&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;comment&amp;quot;: &amp;quot;wrong clause&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;ts&amp;quot;: &amp;quot;2026-11-26T09:14:00Z&amp;quot; }&lt;/span&gt;" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#FFF8DC;strokeColor=#B8A04A;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;spacingRight=2;spacing=0;" vertex="1" parent="grp-repos">
          <mxGeometry x="40" y="730" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pii" value="&lt;b style=&quot;font-size:15px&quot;&gt;PII entity registry&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: key-value store + search index]&lt;/span&gt;&lt;br&gt;• one entity per person, address, company or id: key (PERSON_17), type, encrypted value, aliases, tenant, document ids (filled by step 1)&lt;br&gt;• hybrid-searchable per tenant: BM25 with fuzzy match on aliases + embedding of the mention; query preparation finds the key for a name here&lt;br&gt;• read by key, in batches, by the re-hydration worker; identity vault, access-restricted&lt;br&gt;• erasure: deleting an entity makes every placeholder of it unresolvable at once" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-repos">
          <mxGeometry x="40" y="830" width="320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="note-pii" value="&lt;b style=&quot;font-size:10px&quot;&gt;Example entity record (illustrative)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Courier New;font-size:10px&quot;&gt;{ &amp;quot;entity&amp;quot;: &amp;quot;PERSON_17&amp;quot;, &amp;quot;type&amp;quot;: &amp;quot;PERSON&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;value&amp;quot;: &amp;quot;enc:Jan Kowalski&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;aliases&amp;quot;: [&amp;quot;J. Kowalski&amp;quot;, &amp;quot;Kowalski, Jan&amp;quot;],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;tenant&amp;quot;: &amp;quot;tenant-a&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;docs&amp;quot;: [&amp;quot;doc42&amp;quot;, &amp;quot;doc57&amp;quot;] }&lt;/span&gt;" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#FFF8DC;strokeColor=#B8A04A;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;spacingRight=2;spacing=0;" vertex="1" parent="grp-repos">
          <mxGeometry x="40" y="1030" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="gloss" value="&lt;b style=&quot;font-size:15px&quot;&gt;Glossary store&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: key-value store]&lt;/span&gt;&lt;br&gt;• static acronym / abbreviation → definition and synonyms, O(1) lookup&lt;br&gt;• prepared from the area wiki and existing dictionaries, reviewed by engineers; no LLM involved&lt;br&gt;• lifecycle: versioned, changed through reviewed updates" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-repos">
          <mxGeometry x="40" y="1160" width="320" height="130" as="geometry" />
        </mxCell>
        <mxCell id="note-gloss" value="&lt;b style=&quot;font-size:10px&quot;&gt;Example glossary entry (illustrative)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Courier New;font-size:10px&quot;&gt;&amp;quot;LCR&amp;quot;: { &amp;quot;expansion&amp;quot;: &amp;quot;Liquidity Coverage Ratio&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;synonyms&amp;quot;: [&amp;quot;liquidity coverage&amp;quot;],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;domain&amp;quot;: &amp;quot;treasury&amp;quot;, &amp;quot;version&amp;quot;: 12 }&lt;/span&gt;" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#FFF8DC;strokeColor=#B8A04A;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;spacingRight=2;spacing=0;" vertex="1" parent="grp-repos">
          <mxGeometry x="40" y="1290" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="vec" value="&lt;b style=&quot;font-size:15px&quot;&gt;Vector database&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: vector database]&lt;/span&gt;&lt;br&gt;• child-chunk vectors + permission and entity metadata (filled by step 2)&lt;br&gt;• dense search with metadata filters (tenant, allowed roles)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-repos">
          <mxGeometry x="40" y="1390" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="note-vec" value="&lt;b style=&quot;font-size:10px&quot;&gt;Example vector entry (illustrative)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Courier New;font-size:10px&quot;&gt;id: doc42@v3:c32&lt;br&gt;vector: [0.021, -0.113, … 1024 dims]&lt;br&gt;tenant: tenant-a&amp;nbsp;&amp;nbsp;roles: [legal, compliance]&lt;br&gt;doc: doc42&amp;nbsp;&amp;nbsp;parent: doc42@v3:s7&lt;br&gt;entities: [PERSON_17]&amp;nbsp;&amp;nbsp;embedModel: embed-v2&lt;/span&gt;" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#FFF8DC;strokeColor=#B8A04A;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;spacingRight=2;spacing=0;" vertex="1" parent="grp-repos">
          <mxGeometry x="40" y="1500" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="es" value="&lt;b style=&quot;font-size:15px&quot;&gt;Keyword search index&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: search engine]&lt;/span&gt;&lt;br&gt;• BM25 over the same child chunks with the same permission and entity metadata (filled by step 2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-repos">
          <mxGeometry x="40" y="1630" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note-es" value="&lt;b style=&quot;font-size:10px&quot;&gt;Example index entry (illustrative)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Courier New;font-size:10px&quot;&gt;id: doc42@v3:c32&lt;br&gt;text: &amp;quot;… &amp;lt;Person_17&amp;gt; shall not be liable …&amp;quot;&lt;br&gt;filterable: tenant, roles, doc, entities&lt;br&gt;(placeholders match exactly in BM25)&lt;/span&gt;" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#FFF8DC;strokeColor=#B8A04A;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;spacingRight=2;spacing=0;" vertex="1" parent="grp-repos">
          <mxGeometry x="40" y="1710" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="chunk" value="&lt;b style=&quot;font-size:15px&quot;&gt;Chunk store&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: key-value store]&lt;/span&gt;&lt;br&gt;• chunk id → text, parent id, previous id, next id, section path (filled by step 2)&lt;br&gt;• read by key for the neighbours and the parent section" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-repos">
          <mxGeometry x="40" y="1830" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="note-chunk" value="&lt;b style=&quot;font-size:10px&quot;&gt;Example chunk record (illustrative)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Courier New;font-size:10px&quot;&gt;{ &amp;quot;id&amp;quot;: &amp;quot;doc42@v3:c32&amp;quot;, &amp;quot;parent&amp;quot;: &amp;quot;doc42@v3:s7&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;prev&amp;quot;: &amp;quot;…:c31&amp;quot;, &amp;quot;next&amp;quot;: &amp;quot;…:c33&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;path&amp;quot;: [&amp;quot;4 Liability&amp;quot;, &amp;quot;4.2 Exclusions&amp;quot;],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;pages&amp;quot;: [11, 11], &amp;quot;core&amp;quot;: [120, 860],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;entities&amp;quot;: [&amp;quot;PERSON_17&amp;quot;],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;text&amp;quot;: &amp;quot;… &amp;lt;Person_17&amp;gt; shall not be liable …&amp;quot; }&lt;/span&gt;" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#FFF8DC;strokeColor=#B8A04A;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;spacingRight=2;spacing=0;" vertex="1" parent="grp-repos">
          <mxGeometry x="40" y="1930" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="actor" value="&lt;span style=&quot;color:#ffffff;font-weight:bold;font-size:15px&quot;&gt;Employee&lt;/span&gt;&lt;br&gt;[Person]&lt;br&gt;• asks questions about policies, contracts and regulations" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#06315C;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="240" height="190" as="geometry" />
        </mxCell>
        <mxCell id="idp" value="&lt;b style=&quot;font-size:15px&quot;&gt;Corporate identity provider&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;register / login, federation; issues the JWT with groups and roles; publishes the public key (JWKS)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
