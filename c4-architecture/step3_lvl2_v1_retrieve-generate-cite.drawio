        </mxCell>


        <!-- ============ EDGES (explicit waypoints; data movers are labels, not boxes) ============ -->
        <mxCell id="e-bff" value="question + JWT claims&#10;[queue]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;dashPattern=5 3;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.0741;entryPerimeter=0;" edge="1" parent="1" source="bff" target="retrieve">
          <mxGeometry x="-0.3077" relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e-emb" value="embed query +&#10;definitions&#10;[http]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.0;exitY=0.2778;exitPerimeter=0;entryX=1.0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="retrieve" target="embmodel">
          <mxGeometry x="0.3077" relative="1" as="geometry">
