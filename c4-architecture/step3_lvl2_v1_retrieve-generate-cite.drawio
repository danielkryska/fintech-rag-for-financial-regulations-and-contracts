          <mxGeometry x="0.3077" relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e-rewrite" value="rewrite query (fallback)&#10;[https]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.0;exitY=0.6852;exitPerimeter=0;entryX=1.0;entryY=0.0857;entryPerimeter=0;" edge="1" parent="1" source="retrieve" target="llm">
          <mxGeometry x="0.3077" relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e-llm" value="generate + verify&#10;[https, streaming]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.0;exitY=0.1739;exitPerimeter=0;entryX=1.0;entryY=0.9143;entryPerimeter=0;" edge="1" parent="1" source="generate" target="llm">
          <mxGeometry x="0.3077" relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e-events" value="token / citation /&#10;done / error&#10;[event stream]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;dashPattern=5 3;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.0;exitY=0.4783;exitPerimeter=0;entryX=1.0;entryY=0.2;entryPerimeter=0;" edge="1" parent="1" source="generate" target="edge">
          <mxGeometry x="0.3077" relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e-cancel" value="cancel on disconnect&#10;[event]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;dashPattern=5 3;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=1.0;exitY=0.8;exitPerimeter=0;entryX=0.0;entryY=0.7391;entryPerimeter=0;" edge="1" parent="1" source="edge" target="generate">
          <mxGeometry x="-0.3077" relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e-pass" value="ranked passages, or denied /&#10;insufficient context&#10;[queue]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;dashPattern=5 3;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.2632;exitY=1.0;exitPerimeter=0;entryX=0.2632;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="retrieve" target="generate">
          <mxGeometry x="0.0" relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e-r-gloss" value="expand acronyms&#10;[key-value read]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=1.0;exitY=0.0741;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="retrieve" target="gloss">
          <mxGeometry x="0.0" relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e-r-mem" value="read / update session memory&#10;[key-value read/write]" style="rounded=0;html=1;startArrow=block;startFill=1;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=1.0;exitY=0.2926;exitPerimeter=0;entryX=0.0;entryY=0.4;entryPerimeter=0;" edge="1" parent="1" source="retrieve" target="mem">
          <mxGeometry x="0.0" relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e-r-pii" value="name → placeholder lookup&#10;[key-value read]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=1.0;exitY=0.5111;exitPerimeter=0;entryX=0.0;entryY=0.4;entryPerimeter=0;" edge="1" parent="1" source="retrieve" target="pii">
          <mxGeometry x="0.0" relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e-r-vec" value="dense search + filters&#10;[api call]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=1.0;exitY=0.7296;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="retrieve" target="vec">
          <mxGeometry x="0.0" relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e-r-es" value="BM25 search + filters&#10;[api call]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=1.0;exitY=0.9481;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="retrieve" target="es">
          <mxGeometry x="0.0" relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e-g-parent" value="fetch context chunks&#10;[key-value read]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=1.0;exitY=0.2174;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="generate" target="parent">
          <mxGeometry x="0.0" relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e-g-audit" value="write audit record&#10;[db write]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=1.0;exitY=0.6739;exitPerimeter=0;entryX=0.0;entryY=0.3077;entryPerimeter=0;" edge="1" parent="1" source="generate" target="audit">
          <mxGeometry x="0.0" relative="1" as="geometry">
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
