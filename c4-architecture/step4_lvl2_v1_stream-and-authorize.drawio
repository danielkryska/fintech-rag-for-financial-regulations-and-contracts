          </mxGeometry>
        </mxCell>
        <mxCell id="e-fb" value="store feedback&#10;[key-value write]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=1.0;exitY=0.2353;exitPerimeter=0;entryX=0.0;entryY=0.3636;entryPerimeter=0;" edge="1" parent="1" source="bff" target="feedback">
          <mxGeometry x="0.0" relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e-budget" value="check budget&#10;[key-value read]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=1.0;exitY=0.8235;exitPerimeter=0;entryX=0.0;entryY=0.2727;entryPerimeter=0;" edge="1" parent="1" source="bff" target="quota">
          <mxGeometry x="-0.4222" relative="1" as="geometry">
