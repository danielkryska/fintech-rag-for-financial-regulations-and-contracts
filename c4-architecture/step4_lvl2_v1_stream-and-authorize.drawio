          </mxGeometry>
        </mxCell>
        <mxCell id="e-signin" value="sign in (OIDC)&#10;[https]" style="rounded=0;html=1;startArrow=block;startFill=1;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.0;exitY=0.875;exitPerimeter=0;entryX=1.0;entryY=0.3333;entryPerimeter=0;" edge="1" parent="1" source="web-ui" target="idp">
