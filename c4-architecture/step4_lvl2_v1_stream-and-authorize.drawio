        </mxCell>
        <mxCell id="e-stream-web" value="answer stream&#10;[SSE over https]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;dashPattern=5 3;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.6765;exitY=0.0;exitPerimeter=0;entryX=0.7143;entryY=1.0;entryPerimeter=0;" edge="1" parent="1" source="api-gateway" target="web-ui">
