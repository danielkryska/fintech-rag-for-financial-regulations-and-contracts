        <mxCell id="e-query" value="query message&#10;[queue]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;dashPattern=5 3;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.4231;exitY=1.0;exitPerimeter=0;entryX=0.4231;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="bff" target="workers">
          <mxGeometry x="0.0" relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e-events" value="token / citation /&#10;done / error&#10;[event stream]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;dashPattern=5 3;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.1538;exitY=1.0;exitPerimeter=0;entryX=0.1538;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="workers" target="edge">
