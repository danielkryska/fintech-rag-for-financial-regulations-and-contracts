        <mxCell id="e-usage" value="add consumed tokens&#10;[key-value write]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=1.0;exitY=0.1875;exitPerimeter=0;entryX=0.0;entryY=0.7273;entryPerimeter=0;" edge="1" parent="1" source="edge" target="quota">
          <mxGeometry x="-0.5315" relative="1" as="geometry">
