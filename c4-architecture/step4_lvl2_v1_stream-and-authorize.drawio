            <mxPoint x="-68" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e-cancel" value="cancel on&#10;disconnect&#10;[event]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;dashPattern=5 3;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.4615;exitY=0.0;exitPerimeter=0;entryX=0.4615;entryY=1.0;entryPerimeter=0;" edge="1" parent="1" source="edge" target="workers">
