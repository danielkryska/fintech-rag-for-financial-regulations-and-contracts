          </mxGeometry>
        </mxCell>
        <mxCell id="e-jwt" value="validate JWT&#10;(public key / JWKS)&#10;[http]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.0;exitY=0.5833;exitPerimeter=0;entryX=1.0;entryY=0.6667;entryPerimeter=0;" edge="1" parent="1" source="api-gateway" target="idp">
          <mxGeometry x="0.2222" relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e-route" value="route with JWT&#10;[http]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=1.0;exitY=0.3611;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="api-gateway" target="bff">
          <mxGeometry x="0.3571" relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e-gw-edge" value="answer stream (SSE) /&#10;disconnect notice&#10;[http]" style="rounded=0;html=1;startArrow=block;startFill=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;dashPattern=5 3;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=1.0;exitY=0.7778;exitPerimeter=0;entryX=0.0;entryY=0.1667;entryPerimeter=0;" edge="1" parent="1" source="api-gateway" target="edge">
          <mxGeometry x="0.7313" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="850" y="595" />
              <mxPoint x="850" y="985" />
