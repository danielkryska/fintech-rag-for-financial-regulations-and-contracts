          </mxGeometry>
        </mxCell>
        <mxCell id="e-question" value="submit question&#10;[https]" style="rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.3214;exitY=1.0;exitPerimeter=0;entryX=0.3529;entryY=0.0;entryPerimeter=0;" edge="1" parent="1" source="web-ui" target="api-gateway">
