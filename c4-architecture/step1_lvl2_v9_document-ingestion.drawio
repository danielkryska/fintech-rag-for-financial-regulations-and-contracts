        </mxCell>
        <mxCell id="slice-embed" value="&lt;b style=&quot;font-size:15px&quot;&gt;Indexing coordinator (step 2)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Internal slice: see step 2 diagram]&lt;/span&gt;&lt;br&gt;• consumes document.processed events&lt;br&gt;• embeds the chunks (overlap skipped) and fills the vector DB, keyword index and chunk store" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;dashed=1;dashPattern=8 4;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="2200" y="1040" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="ext-ner" value="&lt;b style=&quot;font-size:15px&quot;&gt;NER model provider&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;hosts the NER model that finds names, organizations and addresses in the chunk text. It sees unredacted text, so it is an internal or in-account private endpoint (no external API, inputs not logged; see ADR). Step 3 uses the same provider for questions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
