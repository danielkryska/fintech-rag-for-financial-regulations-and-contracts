<mxfile host="app.diagrams.net">
  <diagram id="evaluate-and-monitor" name="Evaluate and monitor">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="2400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b style=&quot;font-size:16px&quot;&gt;C4 Level 2 - Evaluate and monitor (step 4, v3, Draft)&lt;/b&gt;&lt;br&gt;Date: 2026-11-28&lt;br&gt;Requirements: FR-03, FR-05, FR-06, FR-07, FR-08, NFR-01, NFR-02, NFR-07, EVAL-01, EVAL-02, EVAL-03, EVAL-04 (RAG triad on the 100-question golden set, CI regression gate)&lt;br&gt;Evaluation loop: change (prompt, retrieval settings, model, index) → CI workflow (GitHub Actions / GitLab CI, external) → evaluation service → query pipeline in evaluation mode (ranked list per search stage) → metrics + LLM judge → results store → gate pass / fail. User feedback and sampled production answers become regression cases once a reviewer confirms them.&lt;br&gt;Monitoring loop: every container of steps 1-3 emits traces, metrics and logs (OpenTelemetry, no personal data) → monitoring service → dashboards per stage and alerts. Online evaluation (no reference answers) has three layers: inline checks on every answer, a stratified sample scored by the judge (calibrated against reviewers), and user signals; the scores are kept per answer in the results store (source = online) and drive trend alerts against the last accepted baseline. Emission is not drawn per container to keep the lines readable.&lt;br&gt;Search and PII metrics: Recall@k, hit rate, MRR, nDCG, context precision per stage (BM25, dense, fused, reranked); PII: NER recall and precision, stem resolution accuracy (wrong merge, missed match), leaks into prompt, audit and logs (must be 0); online: empty-result rate, top-1 score and margin, fallback rate, stage latency, stem hit rate, NER latency and errors. ADRs: observability stack, judge model, gate tolerances, sampling rate, PII evaluation set, evaluation environment (staged corpus) - none accepted yet" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="2540" height="110" as="geometry" />
        </mxCell>
        <mxCell id="sys-container" value="&lt;b style=&quot;font-size:15px&quot;&gt;Enterprise RAG knowledge assistant&lt;/b&gt;&lt;br&gt;[Software System]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F8FD;strokeColor=#6C8EBF;strokeWidth=2;verticalAlign=top;align=center;spacingTop=6;container=1;collapsible=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="120" width="1850" height="2120" as="geometry" />
        </mxCell>
        <mxCell id="grp-repos" value="&lt;b&gt;Repositories (DBs)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;container=1;collapsible=0;fontSize=12;fontStyle=1;" vertex="1" parent="sys-container">
          <mxGeometry x="40" y="50" width="400" height="1410" as="geometry" />
        </mxCell>
        <mxCell id="grp-backend" value="&lt;b&gt;Backend&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;container=1;collapsible=0;fontSize=12;fontStyle=1;" vertex="1" parent="sys-container">
          <mxGeometry x="680" y="50" width="560" height="2070" as="geometry" />
        </mxCell>
        <mxCell id="grp-representation" value="&lt;b&gt;Representation&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;container=1;collapsible=0;fontSize=12;fontStyle=1;" vertex="1" parent="sys-container">
          <mxGeometry x="1440" y="870" width="380" height="380" as="geometry" />
        </mxCell>
        <mxCell id="F" value="&lt;b style=&quot;font-size:15px&quot;&gt;Feedback store&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: database]&lt;/span&gt;&lt;br&gt;• helpful / not helpful mark and usage signals (citation click, copy, cancelled stream) per answer id (filled by step 3)&lt;br&gt;• read by the curation job to find candidate regression cases" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-repos">
          <mxGeometry x="40" y="50" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="note-F" value="&lt;b style=&quot;font-size:10px&quot;&gt;Example feedback record (illustrative)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Courier New;font-size:10px&quot;&gt;{ &amp;quot;msgId&amp;quot;: &amp;quot;m-8841&amp;quot;, &amp;quot;mark&amp;quot;: &amp;quot;not_helpful&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;comment&amp;quot;: &amp;quot;wrong clause&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;ts&amp;quot;: &amp;quot;2026-11-26T09:14:00Z&amp;quot; }&lt;/span&gt;" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#FFF8DC;strokeColor=#B8A04A;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;spacingRight=2;spacing=0;" vertex="1" parent="grp-repos">
          <mxGeometry x="40" y="170" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="A" value="&lt;b style=&quot;font-size:15px&quot;&gt;Audit log&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: database]&lt;/span&gt;&lt;br&gt;• append-only, correlated by message id (filled by step 3)&lt;br&gt;• redacted question, requester, retrieved chunk ids with rank and score per search stage, prompt / model / index version, verification result, tokens&lt;br&gt;• read, redacted, by the curation job and the sampling" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-repos">
          <mxGeometry x="40" y="250" width="320" height="130" as="geometry" />
        </mxCell>
        <mxCell id="note-A" value="&lt;b style=&quot;font-size:10px&quot;&gt;Example audit records (illustrative)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Courier New;font-size:10px&quot;&gt;{ &amp;quot;msgId&amp;quot;: &amp;quot;m-8841&amp;quot;, &amp;quot;stage&amp;quot;: &amp;quot;intake&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;user&amp;quot;: &amp;quot;u-1017&amp;quot;, &amp;quot;decision&amp;quot;: &amp;quot;accepted&amp;quot; }&lt;br&gt;{ &amp;quot;msgId&amp;quot;: &amp;quot;m-8841&amp;quot;, &amp;quot;stage&amp;quot;: &amp;quot;final&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;outcome&amp;quot;: &amp;quot;answered&amp;quot;, &amp;quot;tokens&amp;quot;: 1840,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;question&amp;quot;: &amp;quot;What did &amp;lt;Person_17&amp;gt; agree?&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;sources&amp;quot;: [&amp;quot;doc42@v3:c32&amp;quot;],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;model&amp;quot;: &amp;quot;llm-x@2026-11&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;trail&amp;quot;: [&amp;quot;pii:1&amp;quot;, &amp;quot;filters:ok&amp;quot;, &amp;quot;verify:ok&amp;quot;] }&lt;/span&gt;" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#FFF8DC;strokeColor=#B8A04A;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;spacingRight=2;spacing=0;" vertex="1" parent="grp-repos">
          <mxGeometry x="40" y="380" width="320" height="140" as="geometry" />
        </mxCell>
        <mxCell id="G" value="&lt;b style=&quot;font-size:15px&quot;&gt;Golden &amp;amp; regression set store&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: document store]&lt;/span&gt;&lt;br&gt;• golden set: 100 questions with the relevant passages (document + section, graded), the expected behaviour (answer, insufficient context or denied) and the roles to run with&lt;br&gt;• regression set: confirmed cases from user feedback and failures; candidates wait for a reviewer&lt;br&gt;• labels point to document + section, not chunk ids; versioned, a case is never overwritten&lt;br&gt;• lifecycle: kept; retired cases are marked, not deleted&lt;br&gt;• PII cases: names in spelling variants, inflected forms and typos, ambiguous and unknown names, with the expected entity ids" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-repos">
          <mxGeometry x="40" y="550" width="320" height="260" as="geometry" />
        </mxCell>
        <mxCell id="note-G" value="&lt;b style=&quot;font-size:10px&quot;&gt;Example cases (illustrative)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Courier New;font-size:10px&quot;&gt;{ &amp;quot;case&amp;quot;: &amp;quot;g-017&amp;quot;, &amp;quot;set&amp;quot;: &amp;quot;golden&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;q&amp;quot;: &amp;quot;When is the supplier not liable?&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;relevant&amp;quot;: [{ &amp;quot;doc&amp;quot;: &amp;quot;doc42&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;quot;section&amp;quot;: &amp;quot;4.2 Exclusions&amp;quot;, &amp;quot;grade&amp;quot;: 2 }],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;expect&amp;quot;: &amp;quot;answer&amp;quot;, &amp;quot;roles&amp;quot;: [&amp;quot;legal&amp;quot;] }&lt;br&gt;{ &amp;quot;case&amp;quot;: &amp;quot;rg-0031&amp;quot;, &amp;quot;set&amp;quot;: &amp;quot;regression&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;from&amp;quot;: &amp;quot;feedback m-8841&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;status&amp;quot;: &amp;quot;candidate&amp;quot; }&lt;br&gt;{ &amp;quot;case&amp;quot;: &amp;quot;g-052&amp;quot;, &amp;quot;set&amp;quot;: &amp;quot;golden&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;q&amp;quot;: &amp;quot;What did J. Kowalski sign?&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;expectEntities&amp;quot;: [&amp;quot;PERSON_17&amp;quot;] }&lt;/span&gt;" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#FFF8DC;strokeColor=#B8A04A;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;spacingRight=2;spacing=0;" vertex="1" parent="grp-repos">
          <mxGeometry x="40" y="810" width="320" height="180" as="geometry" />
        </mxCell>
        <mxCell id="R" value="&lt;b style=&quot;font-size:15px&quot;&gt;Evaluation results store&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: database]&lt;/span&gt;&lt;br&gt;• one record per run: trigger, prompt / model / embedding / index versions, metrics overall, per search stage, per question type and per tenant&lt;br&gt;• per-case results: what each stage returned, the answer, the judge verdict&lt;br&gt;• the last accepted run is the baseline of the gate&lt;br&gt;• lifecycle: kept to show the trend; per-case detail dropped after a defined period&lt;br&gt;• online scores of sampled production answers are kept per answer (source = online)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-repos">
          <mxGeometry x="40" y="1020" width="320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="note-R" value="&lt;b style=&quot;font-size:10px&quot;&gt;Example run record (illustrative)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Courier New;font-size:10px&quot;&gt;{ &amp;quot;run&amp;quot;: &amp;quot;r-0412&amp;quot;, &amp;quot;trigger&amp;quot;: &amp;quot;ci&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;prompt&amp;quot;: &amp;quot;p-31&amp;quot;, &amp;quot;embedModel&amp;quot;: &amp;quot;embed-v2&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;index&amp;quot;: &amp;quot;i-118&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;recall@10&amp;quot;: { &amp;quot;bm25&amp;quot;: 0.81, &amp;quot;dense&amp;quot;: 0.84,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;quot;hybrid&amp;quot;: 0.91, &amp;quot;rerank&amp;quot;: 0.93 },&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;mrr&amp;quot;: 0.71, &amp;quot;ndcg@10&amp;quot;: 0.78,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;faithfulness&amp;quot;: 0.92, &amp;quot;relevancy&amp;quot;: 0.87,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;ctxPrecision&amp;quot;: 0.82, &amp;quot;permLeaks&amp;quot;: 0,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;gate&amp;quot;: &amp;quot;pass&amp;quot; }&lt;/span&gt;" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#FFF8DC;strokeColor=#B8A04A;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;spacingRight=2;spacing=0;" vertex="1" parent="grp-repos">
          <mxGeometry x="40" y="1220" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="qs" value="&lt;b style=&quot;font-size:15px&quot;&gt;Online evaluation: quality sampling &amp;amp; curation job&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: batch job]&lt;/span&gt;&lt;br&gt;• samples production answers from the audit log (redacted question, retrieved chunk ids and scores, answer with placeholders) and scores them without reference answers: faithfulness and citation check by the LLM judge, answer relevancy&lt;br&gt;• search health from the audit trail: empty-result rate, top-1 score and margin between rank 1 and 2, share of answers ending in &quot;insufficient context&quot;, rewrite-and-retry rate&lt;br&gt;• publishes the scores as metrics to the monitoring service (same OpenTelemetry path) and writes them per answer to the results store, tagged online, so an alert can be followed down to the answers in the console&lt;br&gt;• curation: picks not-helpful feedback and low-score answers as candidate regression cases (question with placeholders, retrieved sources, answer); a reviewer confirms the relevant passages in the console before a case joins the regression set&lt;br&gt;• works on redacted records only, never on real personal data&lt;br&gt;• PII health: scans the sampled records for PII-like strings that are not placeholders and for placeholders without a registry entry; both rates go out as metrics (a hit means a leak or a missed mention)&lt;br&gt;• sampling is stratified by tenant and question type and biased to low retrieval scores and negative feedback; the rate is an ADR&lt;br&gt;• user signals: not-helpful marks and usage signals (citation click, copy, cancelled stream) from the feedback store; reformulation rate from the audit log (same user rephrases within a minute)&lt;br&gt;• judge calibration: reviewers label a small subset in the console; the agreement between judge and reviewers goes out as a metric, so a drifting judge is noticed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-backend">
          <mxGeometry x="40" y="60" width="480" height="620" as="geometry" />
        </mxCell>
        <mxCell id="evs" value="&lt;b style=&quot;font-size:15px&quot;&gt;Evaluation service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: service + batch runs]&lt;/span&gt;&lt;br&gt;• runs the golden set (100 questions) and the regression set through the real query pipeline as an evaluation user; every case carries the roles it must run with, so permission tests are part of the run&lt;br&gt;• evaluation mode: the retrieve worker also reports the ranked list after each search stage (BM25, dense, fused, reranked), so every stage is scored on its own&lt;br&gt;• search metrics against the labelled passages: Recall@5 / 10 / 20, hit rate, MRR, nDCG@10, context precision and recall; per-stage lift (BM25-only, dense-only, hybrid, rerank); an ablation shows which retriever finds what the others miss&lt;br&gt;• answer metrics by LLM judge (RAG triad): faithfulness ≥ 0.90, answer relevancy ≥ 0.85, context precision ≥ 0.80; also citation accuracy, correct &quot;insufficient context&quot; rate and permission leaks (must be 0)&lt;br&gt;• maps the labels (document + section) to the current chunk ids at run time, so re-chunking or re-embedding does not break the golden set&lt;br&gt;• starts when the CI workflow calls it, nightly against production, after an embedding model or index version change, and on demand from the console; compares with the last accepted run and returns pass / fail&lt;br&gt;• PII resolution against labelled mentions (golden PII cases): NER recall and precision per entity type and language; stem resolution: right entity, wrong entity (wrong merge) and missed match (split or new entity); handling of ambiguous and unknown names&lt;br&gt;• PII boundary: checks that the LLM prompt, the audit record and the logs of an evaluation run contain placeholders only (leaks must be 0) and that the streamed answer carries the right values for the requester's roles, with no placeholder left or half-replaced&lt;br&gt;• gate fails also on any permission or PII leak, a regression case that passed before, or a drop of Recall@10 / MRR / NER recall beyond the agreed tolerance; one run at a time (lock with expiry), a missing result counts as failed&lt;br&gt;• shadow replay (online, optional): replays a sample of redacted production questions through a candidate configuration and compares scores and ranked lists with the current one before it is switched on" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-backend">
          <mxGeometry x="40" y="710" width="480" height="760" as="geometry" />
        </mxCell>
        <mxCell id="mon" value="&lt;b style=&quot;font-size:15px&quot;&gt;Monitoring &amp;amp; alerting service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: observability platform]&lt;/span&gt;&lt;br&gt;• receives traces, metrics and logs (OpenTelemetry) from every container of steps 1-3 and from the evaluation containers; correlated by message id and document id; logs are scrubbed of personal data&lt;br&gt;• search step: latency per stage (query embedding, BM25, dense, fusion, rerank), error and timeout rate, candidates per retriever, empty-result rate, score distribution drift, rerank score drop&lt;br&gt;• generation and streaming: time to first token (P95 ≤ 3 s), tokens per answer, verify-failure and regeneration rate, insufficient-context rate, cancelled streams&lt;br&gt;• ingestion and index: queue depth and age, failed documents, OCR fallback rate, index lag, embedding cost per document&lt;br&gt;• cost and quota: tokens per tenant, budget exhausted, retrieval-only share (NFR-02, NFR-07); feedback: not-helpful rate&lt;br&gt;• dashboards per stage; alert rules on SLO breaches and on quality trends: online scores and inline-check rates against the last accepted baseline (anomaly detection, not fixed thresholds, because scores drift with the question mix), nightly run vs last accepted run; alerts go to the notification service&lt;br&gt;• stores the metric series and traces; retention to be defined&lt;br&gt;• PII pipeline: NER latency and errors, stem hit rate, unknown / ambiguous name rate, new entities per document, mentions in review, placeholders replaced and unknown keys; alerts on a hit-rate drop, NER errors or any personal-data pattern in logs&lt;br&gt;• online quality and drift: inline answer checks, judge scores from the sampler, judge-vs-reviewer agreement, user signals (not-helpful rate, reformulation, citation click and copy, cancelled streams), query mix by question type and tenant, corpus freshness" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-backend">
          <mxGeometry x="40" y="1560" width="480" height="470" as="geometry" />
        </mxCell>
        <mxCell id="con" value="&lt;b style=&quot;font-size:15px&quot;&gt;Evaluation console&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Container: web ui]&lt;/span&gt;&lt;br&gt;• lists runs and compares them: metrics per stage, per question type and per tenant&lt;br&gt;• drill-down into a failed question: relevant passages, what each stage returned, the answer and the judge verdict&lt;br&gt;• review queue: the reviewer confirms or rejects candidate regression cases and marks the relevant passages&lt;br&gt;• starts a run on demand&lt;br&gt;• online view: sampled production answers with their scores; reviewers label a small subset to calibrate the judge" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="grp-representation">
          <mxGeometry x="40" y="40" width="300" height="310" as="geometry" />
        </mxCell>
        <mxCell id="ci" value="&lt;b style=&quot;font-size:15px&quot;&gt;CI pipeline&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[External system: GitHub Actions / GitLab CI]&lt;/span&gt;&lt;br&gt;• a GitHub Actions or GitLab CI workflow in the code repository: your standard CI, not an AWS pipeline&lt;br&gt;• runs on every pull request that changes prompts, retrieval settings, model, embedding or index version; step 2 triggers it too (workflow dispatch) when the embedding model changes&lt;br&gt;• authenticates to the evaluation service with a short-lived OIDC token, no stored secret&lt;br&gt;• starts a run and polls with a deadline; no result counts as failed&lt;br&gt;• required status check: blocks the merge when the gate of the evaluation service fails" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2440" y="1430" width="260" height="320" as="geometry" />
        </mxCell>
        <mxCell id="stp" value="&lt;b style=&quot;font-size:15px&quot;&gt;Containers of steps 1-3&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;[Internal slices: see steps 1, 2 and 3]&lt;/span&gt;&lt;br&gt;• query pipeline: BFF, PII hydration, query preparation, retrieve &amp;amp; rerank, context builder, answer worker (re-hydrates on the fly), edge streaming service&lt;br&gt;• ingestion and indexing workers&lt;br&gt;• answers evaluation questions like any user question; in evaluation mode the retrieve worker also reports the ranked list per stage&lt;br&gt;• every container emits traces, metrics and logs with OpenTelemetry&lt;br&gt;• inline checks on every answer, emitted as metrics: citation validity, verify result, placeholder integrity, PII-like strings in the output, no-answer and rewrite-retry rate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="sys-container">
          <mxGeometry x="1480" y="1450" width="300" height="320" as="geometry" />
        </mxCell>
        <mxCell id="judge" value="&lt;b style=&quot;font-size:15px&quot;&gt;LLM judge provider&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;scores faithfulness, answer relevancy and context precision; a different model family than the answer model; private or API (see ADR); sees redacted text only" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2440" y="710" width="260" height="250" as="geometry" />
        </mxCell>
        <mxCell id="rev" value="&lt;span style=&quot;color:#ffffff;font-weight:bold;font-size:15px&quot;&gt;Reviewer&lt;/span&gt;&lt;br&gt;[Person]&lt;br&gt;• marks answers helpful or not; confirms regression cases; labels a sample of answers to calibrate the judge" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#06315C;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2440" y="1015" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="eng" value="&lt;span style=&quot;color:#ffffff;font-weight:bold;font-size:15px&quot;&gt;Retrieval engineer&lt;/span&gt;&lt;br&gt;[Person]&lt;br&gt;• changes prompts, retrieval settings and models; compares evaluations" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#06315C;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2440" y="1210" width="260" height="150" as="geometry" />
        </mxCell>
